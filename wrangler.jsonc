{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "inspistate",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// IDs to replace per environment (see DEPLOY.md):
	//   d1_databases[0].database_id → from `npx wrangler d1 create inspistate-db`
	//   kv_namespaces[0].id         → from `npx wrangler kv namespace create SESSION`
	// The R2 bucket is referenced by name (`npx wrangler r2 bucket create inspistate-media`); IMAGES needs no id.
	// `npm run doctor -- --remote` flags placeholder ids.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "inspistate-db",
			"database_id": "2d426abc-9152-4be0-a4de-92e079a5d491",
			// Local dev keeps using the original placeholder id, so existing local data under .wrangler/ stays put.
			"preview_database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "inspistate-media"
		}
	],
	// Used by the Astro Cloudflare adapter: Cloudflare Images for image processing in production.
	"images": {
		"binding": "IMAGES"
	},
	// Used by the Astro Cloudflare adapter for sessions. Replace the placeholder id with your own namespace's id.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "00000000000000000000000000000000"
		}
	]
}
