---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompareTray from '../components/islands/CompareTray';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description = 'InspiState — buy, rent and discover new projects across India.', jsonLd, noindex = false } = Astro.props;
const fullTitle = title.includes('InspiState') ? title : `${title} | InspiState`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen overflow-x-hidden w-full max-w-full relative" data-user={Astro.locals.user ? '1' : '0'}>
    <Header />
    <main class="overflow-x-hidden w-full max-w-full">
      <slot />
    </main>
    <Footer />
    <CompareTray client:idle />
  </body>
</html>
