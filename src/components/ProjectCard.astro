---
import type { Project } from '../data/types';
import ShortlistButton from './islands/ShortlistButton';
import { getRefs } from '../lib/repo';
import { formatRange } from '../lib/format';
import { projectUrl } from '../lib/urls';

interface Props { project: Project; layout?: 'card' | 'row' }
const { project: p, layout = 'card' } = Astro.props;
const refs = await getRefs();
const loc = refs.locality(p.citySlug, p.localitySlug);
const city = refs.city(p.citySlug);
const badge = {
  'New Launch': 'bg-white/95 text-brand-950 border border-white/60 shadow-xs',
  'Under Construction': 'bg-amber-400 text-brand-950 border border-amber-300/80 shadow-xs',
  'Ready to Move': 'bg-emerald-600 text-white border border-emerald-500/80 shadow-xs',
}[p.status];
const luxuryImages = [
  '/images/project-luxury-tower.jpg',
  '/images/project-luxury-villa.jpg',
  '/images/apartment-luxury-sea.jpg',
  '/images/interior-luxury-living.jpg',
  '/images/commercial-luxury-tower.jpg',
  '/images/hero-luxury.jpg',
];
// The admin's cover photo when there is one, else a stock image.
const img = p.cover ?? luxuryImages[p.id % luxuryImages.length];
---
<article class:list={['group overflow-hidden rounded-2xl bg-white border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_40px_rgba(7,14,31,0.12)] hover:border-slate-300', layout === 'row' && 'flex flex-col sm:flex-row']}>
  <a href={projectUrl(p)} class:list={['relative block overflow-hidden bg-slate-900', layout === 'row' ? 'h-48 sm:h-auto sm:w-72 sm:shrink-0' : 'aspect-[16/10]']}>
    <img src={img} alt={`${p.name}, ${loc?.name}`} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-108" />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950/80 via-brand-950/20 to-brand-950/40"></div>
    <div class="absolute left-3 top-3 flex items-center gap-1.5">
      <span class:list={['rounded-full px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider backdrop-blur-md', badge]}>{p.status}</span>
      <span class="inline-flex items-center gap-1 rounded-full bg-brand-950/80 backdrop-blur-md px-2.5 py-1 text-[9px] font-bold text-amber-300 border border-white/20">
        <svg class="h-2.5 w-2.5 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        Tour
      </span>
    </div>
    <div class="absolute right-3 top-3"><ShortlistButton client:visible kind="project" id={p.id} /></div>
    <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-white/90 text-xs">
      <span class="flex items-center gap-1 text-[11px] font-medium drop-shadow-sm">
        <svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
        {loc?.name}
      </span>
      <span class="text-[10px] font-bold uppercase tracking-wider text-amber-300 drop-shadow-sm">RERA Verified</span>
    </div>
  </a>
  <div class="p-4 sm:p-5">
    <div class="flex items-start justify-between gap-2">
      <div>
        <a href={projectUrl(p)} class="block font-bold text-slate-900 text-[15px] sm:text-[16px] leading-snug transition group-hover:text-amber-700">{p.name}</a>
        <p class="mt-0.5 text-xs text-slate-500 font-medium">{city?.name}</p>
      </div>
    </div>
    <p class="mt-3 text-[17px] sm:text-[18px] font-extrabold text-slate-900 tracking-tight">
      {formatRange(p.priceMin, p.priceMax)}
    </p>
    <div class="mt-2.5 flex items-center gap-1.5 flex-wrap">
      <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 border border-slate-200/60">{p.bhkLabel}</span>
      <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 border border-slate-200/60">{p.possession}</span>
    </div>
  </div>
</article>
