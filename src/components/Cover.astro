---
// Illustrated picture for a property, project or place. Images live in public/images and are
// generated by db/build-images.ts; swap any file for a real photo with the same name.
interface Props { hue: number; kind?: 'tower' | 'house' | 'plot' | 'office'; label?: string; class?: string; image?: string; alt?: string }
const { hue, kind = 'tower', label, class: cls = '', image, alt = '' } = Astro.props;
const src = image ?? (kind === 'house' ? '/images/villa.svg' : kind === 'plot' ? '/images/plot.svg' : kind === 'office' ? '/images/office.svg' : `/images/project-${(Math.abs(Math.round(hue)) % 6) + 1}.svg`);
---
<div class:list={['relative overflow-hidden bg-brand-100', cls]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
  {label && <span class="absolute left-3 top-3 rounded-md bg-white/95 px-2 py-1 text-[11px] font-semibold text-brand-900 shadow-sm">{label}</span>}
  <slot />
</div>
