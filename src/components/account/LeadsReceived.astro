---
// "Leads Received": buyer enquiries on the account's own listings. Used on /account and /account/agent.
// Buyer numbers on Agent-posted listings need a paid plan, whatever the current role (switching
// agent → seller must not unmask them). Leads on the owner's own (Owner-posted) listings are always shown.
import type { leadsReceived } from '../../lib/accounts';
import { fmtDate, h2 } from './shared';

interface Props { leads: Awaited<ReturnType<typeof leadsReceived>>; hasPlan: boolean }
const { leads, hasPlan } = Astro.props;
const isMasked = (d: { posted_by: string }) => d.posted_by === 'Agent' && !hasPlan;
const anyMasked = leads.some(isMasked);
const mask = (p: string) => `${p.slice(0, 2)}••••••${p.slice(-2)}`;
---
<section id="leads" class="scroll-mt-28">
  <h2 class={h2}>Leads Received</h2>
  {anyMasked && <p class="mt-2 text-sm text-[#1C1A17]/65">Buyer numbers are hidden on the free plan. <a href="/account/plans" class="font-semibold underline">Choose a plan</a> to see them.</p>}
  {leads.length ? (
    <ul class="mt-4 border-t-[0.5px] border-[#1C1A17]/15">
      {leads.map((d) => (
        <li class="flex flex-wrap items-center justify-between gap-2 border-b-[0.5px] border-[#1C1A17]/15 bg-white px-4 py-3.5 text-sm">
          <span><b>{d.name}</b> · {isMasked(d) ? <span class="font-mono">+91 {mask(d.phone)}</span> : <a href={`tel:+91${d.phone}`} class="font-mono underline">+91 {d.phone}</a>} <span class="ml-1 font-mono text-[10px] uppercase tracking-[0.14em] text-[#1C1A17]/50">{d.kind.replace('-', ' ')} · #{d.listing_id}</span></span>
          <span class="text-[#1C1A17]/55">{fmtDate(d.created_at)}</span>
        </li>
      ))}
    </ul>
  ) : <p class="mt-4 border-[0.5px] border-dashed border-[#1C1A17]/25 p-6 text-sm text-[#1C1A17]/60">Enquiries from buyers on your listings will show up here.</p>}
</section>
