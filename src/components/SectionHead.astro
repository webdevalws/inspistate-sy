---
interface Props { eyebrow?: string; title: string; sub?: string; href?: string; linkLabel?: string }
const { eyebrow, title, sub, href, linkLabel = 'View All' } = Astro.props;
---
<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-slate-100 pb-5 mb-6">
  <div>
    {eyebrow && (
      <div class="mb-2 flex items-center gap-2">
        <span class="h-1.5 w-6 rounded-full bg-gradient-to-r from-amber-400 to-amber-600"></span>
        <p class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-accent-700">{eyebrow}</p>
      </div>
    )}
    <h2 class="section-title text-slate-900">{title}</h2>
    {sub && <p class="section-sub">{sub}</p>}
  </div>
  {href && (
    <a href={href} class="group inline-flex shrink-0 items-center gap-2 self-start sm:self-end rounded-full border border-slate-200/90 bg-slate-50/80 px-4 py-2 text-xs font-bold text-slate-700 transition duration-200 hover:border-amber-400 hover:bg-white hover:text-brand-950 hover:shadow-xs">
      <span>{linkLabel}</span>
      <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1 text-amber-600" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  )}
</div>
