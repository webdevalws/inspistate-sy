---
import Newsletter from './islands/Newsletter';
import { getRefs } from '../lib/repo';
import { currentCity } from '../lib/city';

const { cities } = await getRefs();
// "Popular searches" links follow the current city (URL, else the header city picker's choice).
const c0 = currentCity(Astro.url, Astro.cookies, cities).slug;
// The homepage ends on a dark band, so the footer sits flush there; other pages get breathing room.
const flush = Astro.url.pathname === '/';
const cols: [string, [string, string][]][] = [
  ['Popular Searches', [['Buy Properties', `/buy/${c0}`], ['Rent Properties', `/rent/${c0}`], ['New Projects', `/new-projects/${c0}`], ['Commercial Properties', `/commercial/${c0}`], ['Plots & Land', `/buy/${c0}/plot`], ['Villas', `/buy/${c0}/villa`], ['2/3 BHK Apartments', `/buy/${c0}?bhk=2,3`], ['Ready to Move', `/buy/${c0}?possession=Ready+to+Move`]]],
  ['Company', [['About Us', '/about'], ['Careers', '/careers'], ['Press', '/press'], ['Contact Us', '/contact'], ['Partner With Us', '/partner-with-us'], ['Advertise', '/advertise'], ['For Businesses', '/business'], ['Download App', '/app-download'], ['Help Center', '/faq'], ['Fraud Awareness', '/fraud-awareness'], ['Terms & Conditions', '/terms'], ['Privacy Policy', '/privacy']]],
  ['Services', [['Home Loan Calculator', '/tools/loan-eligibility'], ['Property Value Calculator', '/tools/property-valuation'], ['Rental Yield Finder', `/localities/${c0}/rental-yield`], ['Stamp Duty Calculator', '/tools/stamp-duty'], ['EMI Calculator', '/tools/emi-calculator'], ['Expert Consultation', '/contact'], ['Home Services', '/services'], ['Free Property Listing', '/post-property']]],
];
const socials: [string, string][] = [
  ['Facebook', 'M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z'],
  ['X', 'M4 4l16 16M20 4 4 20'],
  ['Instagram', 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM17.5 6.5h.01'],
  ['YouTube', 'M3 8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zM10 9l5 3-5 3z'],
  ['LinkedIn', 'M4 9h4v11H4zM6 4a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 9h4v2a4 4 0 0 1 7 3v6h-4v-6a2 2 0 0 0-4 0v6h-3z'],
];
---
<footer id="site-footer" class:list={['print:hidden relative w-full overflow-hidden bg-[#1C1A17] text-sand-50', flush ? 'border-t-[0.5px] border-sand-50/10' : 'mt-16']}>
  <!-- Signature: the wordmark sits behind the towers, echoing the hero -->
  <div class="ft-art mt-10 sm:mt-14" aria-hidden="true">
    <span class="ft-wordmark font-display font-extrabold uppercase leading-[0.8] text-sand-50/90">InspiState</span>
    <img src="/images/hero-towers-cut.webp" alt="" loading="lazy" />
    <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-[#1C1A17] to-transparent"></div>
  </div>
  <!-- Home page only: tagline under the wordmark, styled like the footer's bottom-row tagline -->
  {flush && <p class="container-x relative pb-8 text-center font-mono text-[10px] uppercase tracking-[0.18em] text-sand-50/50">Search smarter. Live better.</p>}

  <!-- Options: newsletter + quick actions, then the link directory -->
  <div class="container-x relative grid gap-12 border-t-[0.5px] border-sand-50/15 py-12 sm:py-14 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <p class="max-w-xs text-sm leading-relaxed text-sand-50/70">Verified homes, honest data and zero brokerage — across India's prime cities.</p>
      <div class="ed-pair ed-pair-tight mt-6">
        <a href={`/buy/${c0}`} class="ed-btn ed-btn-sand">Explore homes <span aria-hidden="true">→</span></a>
        <a href="/post-property" class="ed-btn ed-btn-ghost-light">Post property free</a>
      </div>
      <p class="ed-label mt-10 text-sand-50/55"><span class="bracket"></span>Market notes · monthly</p>
      <div class="mt-3"><Newsletter client:visible /></div>
      <ul class="mt-6 flex gap-2">
        {socials.map(([n, d]) => (
          <li>
            <span class="grid h-10 w-10 cursor-pointer place-items-center border-[0.5px] border-sand-50/25 text-sand-50/80 transition hover:border-sand-50 hover:bg-sand-50 hover:text-[#1C1A17]" title={n} aria-label={n}>
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <nav class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 lg:col-span-8" aria-label="Footer">
      {cols.map(([title, links]) => (
        <div>
          <h3 class="ed-label !text-sand-50/55"><span class="bracket"></span>{title}</h3>
          <ul class="mt-5 space-y-2.5 text-[13px]">{links.map(([l, h]) => <li><a href={h} class="nav-line text-sand-50/70 transition hover:text-sand-50">{l}</a></li>)}</ul>
        </div>
      ))}
      <div>
        <h3 class="ed-label !text-sand-50/55"><span class="bracket"></span>Popular Cities</h3>
        <ul class="mt-5 space-y-2.5 text-[13px]">{cities.slice(0, 10).map((c) => <li><a href={`/city/${c.slug}`} class="nav-line text-sand-50/70 transition hover:text-sand-50">{c.name}</a></li>)}</ul>
      </div>
    </nav>
  </div>

  <div class="container-x relative flex flex-col gap-3 border-t-[0.5px] border-sand-50/15 py-6 font-mono text-[10px] uppercase tracking-[0.18em] text-sand-50/50 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} InspiState · Listings shown are demo data</p>
    <p class="hidden md:block">Build your future. Find your home.</p>
    <a href="#" class="nav-line self-start text-sand-50/80 transition hover:text-sand-50 sm:self-auto">Back to top ↑</a>
  </div>
</footer>
