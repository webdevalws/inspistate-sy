---
import type { Listing } from '../data/types';
import Photo from './Photo.astro';
import ShortlistButton from './islands/ShortlistButton';
import LeadDialog from './islands/LeadDialog';
import { getRefs } from '../lib/repo';
import { daysSince, listingPrice, listingTitle, pgFacts } from '../lib/listing';
import { formatNumber, formatRate, postedAgo } from '../lib/format';
import { listingUrl } from '../lib/urls';

interface Props { listing: Listing }
const { listing: l } = Astro.props;
const refs = await getRefs();
const loc = refs.locality(l.citySlug, l.localitySlug);
const title = listingTitle(l, refs);
const kind = l.type === 'Plot' ? 'plot' : l.segment === 'commercial' ? 'office' : l.type === 'Villa' ? 'house' : 'tower';
const facts = l.pg ? ['PG / Co-living', ...pgFacts(l), l.furnishing] : [
  l.bhk ? `${l.bhk} BHK` : l.type,
  `${formatNumber(l.areaSqft)} sq.ft`,
  l.type !== 'Plot' ? l.furnishing : null,
  l.possession,
].filter(Boolean);
---
<article class="card group flex flex-col overflow-hidden sm:flex-row rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-all duration-300 hover:shadow-[0_16px_36px_rgba(7,14,31,0.09)] hover:border-slate-300 hover:-translate-y-0.5">
  <a href={listingUrl(l)} class="relative block sm:w-72 sm:shrink-0 overflow-hidden bg-slate-900">
    <Photo photo={l.photos[0]} hue={l.hue} kind={kind} alt={title} class="h-48 sm:h-full sm:min-h-48 transition-transform duration-700 ease-out group-hover:scale-105" label={l.managed ? '★ Managed · Zero brokerage' : l.verified ? '✓ Verified' : undefined} />
    <div class="absolute right-3 top-3"><ShortlistButton client:visible kind="listing" id={l.id} /></div>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <a href={listingUrl(l)} class="text-[16px] font-bold text-slate-900 transition hover:text-amber-700 leading-snug">{title}</a>
        {l.projectSlug && <p class="mt-1 text-xs text-slate-500">in <a href={`/projects/${l.citySlug}/${l.projectSlug}`} class="font-semibold text-brand-700 hover:underline">{l.projectName}</a></p>}
        {!l.projectSlug && loc && <p class="mt-1 text-xs text-slate-500 font-medium">{loc.name}, {refs.city(l.citySlug)?.name}</p>}
      </div>
      <div class="text-right shrink-0">
        <p class="text-xl font-extrabold text-slate-900 tracking-tight">{listingPrice(l)}</p>
        {l.purpose === 'buy' && <p class="mt-0.5 text-xs text-slate-400 font-medium">{formatRate(l.price / l.areaSqft)}</p>}
      </div>
    </div>
    <ul class="mt-3.5 flex flex-wrap gap-1.5">
      {facts.map((f) => <li class="inline-flex items-center rounded-lg bg-slate-100/90 border border-slate-200/60 px-2.5 py-1 text-xs font-semibold text-slate-600">{f}</li>)}
    </ul>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-5 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        <span class="font-bold text-slate-700">{l.contactName}</span> · {l.postedBy} · {postedAgo(daysSince(l.postedAt))}
      </p>
      <div class="flex shrink-0 items-center gap-2">
        {Astro.locals.user ? (
          <LeadDialog client:visible kind="view-number" label="View Number" subject={title} listingId={l.id} className="btn-ghost px-3.5 py-2 text-xs font-semibold rounded-xl" />
        ) : (
          // Owner numbers need an account: logged-out visitors get the login dialog (a /login link without JS).
          <a href={`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`} data-auth-open class="btn-ghost px-3.5 py-2 text-xs font-semibold rounded-xl">View Number</a>
        )}
        <a href={`${listingUrl(l)}#contact`} class="btn-primary px-4 py-2 text-xs font-bold rounded-xl">Contact {l.postedBy === 'Owner' ? 'Owner' : l.postedBy === 'Builder' ? 'Builder' : 'Agent'}</a>
      </div>
    </div>
  </div>
</article>
