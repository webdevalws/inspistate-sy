---
// Square outlined icon button for admin row actions (inside a <form>, posts name=action value=…), or a link when
// `href` is given. The label is the tooltip and the screen-reader name.
interface Props { label: string; icon: 'edit' | 'delete' | 'check' | 'close' | 'eye' | 'eye-off' | 'up' | 'down'; value?: string; href?: string; tone?: 'neutral' | 'danger'; confirm?: string }
const { label, icon, value, href, tone = 'neutral', confirm } = Astro.props;
const PATHS: Record<Props['icon'], string> = {
  edit: 'M4 20h4l10-10-4-4L4 16zM13.5 6.5l4 4',
  delete: 'M5 7h14M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3',
  check: 'M5 12l4 4 10-10',
  close: 'M6 6l12 12M18 6 6 18',
  eye: 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  'eye-off': 'M3 3l18 18M10.6 6.1A10 10 0 0 1 12 6c6 0 10 6 10 6a17 17 0 0 1-3.2 3.8M6.6 7.6C3.9 9.4 2 12 2 12s4 7 10 7a9.6 9.6 0 0 0 4.4-1.1',
  up: 'M12 19V5M6 11l6-6 6 6',
  down: 'M12 5v14M6 13l6 6 6-6',
};
const cls = ['grid h-9 w-11 place-items-center rounded-md border bg-white transition', tone === 'danger' ? 'border-rose-300 text-rose-600 hover:bg-rose-50' : 'border-brand-300 text-brand-700 hover:bg-brand-50'];
const svg = `<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${PATHS[icon]}" /></svg>`;
---
{href ? (
  <a href={href} class:list={cls} title={label} aria-label={label} set:html={svg} />
) : (
  <button name="action" value={value} class:list={cls} title={label} aria-label={label} onclick={confirm ? `return confirm(${JSON.stringify(confirm)})` : undefined} set:html={svg} />
)}
