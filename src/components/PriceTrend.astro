---
// Server-rendered line chart — no client JS needed.
import { formatNumber } from '../lib/format';

interface Props { points: { label: string; rate: number }[] }
const { points } = Astro.props;
const W = 640, H = 220, P = { l: 56, r: 16, t: 16, b: 32 };
const rates = points.map((p) => p.rate);
const lo = Math.min(...rates) * 0.97, hi = Math.max(...rates) * 1.03;
const x = (i: number) => P.l + (i * (W - P.l - P.r)) / (points.length - 1);
const y = (v: number) => P.t + (1 - (v - lo) / (hi - lo)) * (H - P.t - P.b);
const line = points.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.rate).toFixed(1)}`).join(' ');
const area = `${line} L${x(points.length - 1)},${H - P.b} L${x(0)},${H - P.b} Z`;
const ticks = [0, 0.5, 1].map((t) => lo + t * (hi - lo));
const change = ((rates.at(-1)! - rates[0]) / rates[0]) * 100;
---
<figure>
  <figcaption class="mb-2 flex items-baseline justify-between text-sm">
    <span class="text-slate-500">Average rate (₹/sq.ft), last 8 quarters</span>
    <span class:list={['font-bold', change >= 0 ? 'text-brand-700' : 'text-rose-600']}>{change >= 0 ? '▲' : '▼'} {Math.abs(change).toFixed(1)}%</span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-label={`Price trend from ₹${formatNumber(rates[0])} to ₹${formatNumber(rates.at(-1)!)} per sq.ft`}>
    {ticks.map((t) => (
      <g>
        <line x1={P.l} x2={W - P.r} y1={y(t)} y2={y(t)} stroke="#e7e0d6" />
        <text x={P.l - 8} y={y(t) + 4} text-anchor="end" class="fill-slate-400 text-[11px]">{formatNumber(t)}</text>
      </g>
    ))}
    <path d={area} fill="#b48b5d" fill-opacity="0.12" />
    <path d={line} fill="none" stroke="#b48b5d" stroke-width="2.5" stroke-linejoin="round" />
    {points.map((p, i) => (
      <g>
        <circle cx={x(i)} cy={y(p.rate)} r="3.5" fill="white" stroke="#b48b5d" stroke-width="2"><title>{p.label}: ₹{formatNumber(p.rate)}/sq.ft</title></circle>
        <text x={x(i)} y={H - 10} text-anchor="middle" class="fill-slate-400 text-[11px]">{p.label}</text>
      </g>
    ))}
  </svg>
</figure>
