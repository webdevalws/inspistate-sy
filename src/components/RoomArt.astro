---
// Generated room illustration for design ideas (no stock photos). Varies by category, colour, style and seed.
import { COLOUR_HEX } from '../data/interiors';

interface Props { category: string; colour: string; style: string; seed: number; class?: string; title?: string }
const { category, colour, style, seed, class: cls = '', title } = Astro.props;
const [wall, accent] = COLOUR_HEX[colour] ?? ['#efe9e0', '#8b6b4a'];
const wood = style === 'Industrial' ? '#5b5f66' : style === 'Scandinavian' || style === 'Minimalist' ? '#d9b98f' : style === 'Luxurious' ? '#3b2a1e' : '#a4703f';
const floor = style === 'Luxurious' ? '#e9e4dc' : style === 'Industrial' ? '#b9bcc2' : '#d8c3a5';
const r = (n: number) => ((seed * 9301 + n * 49297) % 233280) / 233280;
const winX = 30 + Math.round(r(1) * 160);
const group =
  /kitchen/.test(category) ? 'kitchen'
  : /bedroom|kids/.test(category) ? 'bed'
  : /wardrobe|crockery|tv|pooja|study/.test(category) ? 'cabinet'
  : /bath/.test(category) ? 'bath'
  : /living|dining|balcony/.test(category) ? 'living'
  : 'wall';
---
<svg viewBox="0 0 320 220" class={cls} role="img" aria-label={title ?? `${style} ${category.replace(/-/g, ' ')} illustration`} preserveAspectRatio="xMidYMid slice">
  <rect width="320" height="160" fill={wall} />
  <rect y="160" width="320" height="60" fill={floor} />
  <path d="M0 160h320" stroke="#00000014" stroke-width="2" />
  {style !== 'Minimalist' && <rect x="0" y="0" width="320" height="14" fill={accent} opacity=".18" />}
  {group !== 'kitchen' && group !== 'bath' && (
    <g><rect x={winX} y="28" width="70" height="64" rx="3" fill="#cfe6f5" stroke="#fff" stroke-width="4" /><path d={`M${winX + 35} 28v64M${winX} 60h70`} stroke="#fff" stroke-width="3" /></g>
  )}
  {group === 'living' && (
    <g>
      <rect x="40" y="118" width="150" height="34" rx="8" fill={accent} />
      <rect x="40" y="104" width="150" height="22" rx="8" fill={accent} opacity=".85" />
      <rect x="32" y="112" width="18" height="42" rx="6" fill={accent} /><rect x="182" y="112" width="18" height="42" rx="6" fill={accent} />
      <rect x="210" y="132" width="70" height="8" rx="2" fill={wood} /><path d="M218 140v20M272 140v20" stroke={wood} stroke-width="4" />
      <circle cx="245" cy="122" r="10" fill="#7aa874" /><rect x="240" y="128" width="10" height="6" fill="#b5835a" />
      <path d={`M${250 + r(3) * 40} 0v40`} stroke="#555" /><circle cx={250 + r(3) * 40} cy="46" r="8" fill="#f4d58d" />
    </g>
  )}
  {group === 'bed' && (
    <g>
      <rect x="70" y="84" width="170" height="44" rx="6" fill={wood} />
      <rect x="62" y="124" width="186" height="34" rx="6" fill="#fff" stroke="#00000010" />
      <rect x="62" y="140" width="186" height="18" rx="4" fill={accent} />
      <rect x="84" y="112" width="44" height="16" rx="6" fill="#fff" stroke="#00000015" /><rect x="182" y="112" width="44" height="16" rx="6" fill="#fff" stroke="#00000015" />
      <rect x="252" y="126" width="34" height="32" rx="3" fill={wood} /><circle cx="269" cy="116" r="8" fill="#f4d58d" />
      {category === 'kids-room' && <g><circle cx="40" cy="60" r="10" fill="#f2b84b" /><path d="M20 140l15-30 15 30z" fill="#e57373" /></g>}
    </g>
  )}
  {group === 'cabinet' && (
    <g>
      <rect x="40" y="40" width="240" height="118" rx="3" fill={wood} />
      {Array.from({ length: 4 }, (_, i) => <rect x={46 + i * 59} y="46" width="53" height="106" rx="2" fill={i % 2 ? accent : wood} opacity={i % 2 ? 0.85 : 1} stroke="#00000020" />)}
      {Array.from({ length: 4 }, (_, i) => <rect x={92 + i * 59 - 6} y="92" width="3" height="20" rx="1.5" fill="#d4c39a" />)}
      {category.includes('tv') && <rect x="110" y="50" width="100" height="58" rx="3" fill="#1f2937" />}
      {category.includes('pooja') && <path d="M160 52l26 22h-52z" fill="#f2b84b" />}
    </g>
  )}
  {group === 'kitchen' && (
    <g>
      <rect x="20" y="30" width="280" height="42" fill={accent} opacity=".9" />
      {Array.from({ length: 5 }, (_, i) => <rect x={24 + i * 55} y="34" width="51" height="34" rx="2" fill={accent} stroke="#00000018" />)}
      <rect x="20" y="72" width="280" height="40" fill={category.includes('tiles') ? '#fff' : wall} />
      {category.includes('tiles') && Array.from({ length: 28 }, (_, i) => <rect x={20 + (i % 14) * 20} y={72 + Math.floor(i / 14) * 20} width="20" height="20" fill="none" stroke={accent} stroke-opacity=".5" />)}
      <rect x="20" y="112" width="280" height="8" fill="#2f2f33" />
      <rect x="20" y="120" width="280" height="40" fill={wood} />
      {Array.from({ length: 5 }, (_, i) => <rect x={24 + i * 55} y="124" width="51" height="32" rx="2" fill={wood} stroke="#00000020" />)}
      <rect x={120 + r(4) * 120} y="98" width="50" height="14" fill="#9aa0a6" /><rect x={30 + r(5) * 60} y="104" width="44" height="8" rx="2" fill="#555" />
      {seed % 3 === 0 && <g><rect x="90" y="170" width="140" height="10" fill="#2f2f33" /><rect x="92" y="180" width="136" height="30" fill={wood} /></g>}
      {seed % 3 === 1 && Array.from({ length: 3 }, (_, i) => <rect x={40 + i * 90} y="76" width="60" height="4" fill={wood} />)}
    </g>
  )}
  {group === 'bath' && (
    <g>
      {Array.from({ length: 48 }, (_, i) => <rect x={(i % 12) * 27} y={Math.floor(i / 12) * 40} width="27" height="40" fill="none" stroke={accent} stroke-opacity=".25" />)}
      <rect x="40" y="96" width="110" height="20" rx="3" fill="#fff" stroke="#0000001a" /><rect x="40" y="116" width="110" height="40" fill={wood} />
      <rect x="66" y="40" width="58" height="50" rx="26" fill="#dfeef7" stroke="#fff" stroke-width="4" />
      <rect x="190" y="40" width="96" height="120" fill="#e6f1f7" opacity=".7" stroke="#fff" stroke-width="3" /><path d="M238 50v20" stroke="#9aa0a6" stroke-width="3" />
    </g>
  )}
  {group === 'wall' && (
    <g>
      {category.includes('ceiling')
        ? <g><rect x="20" y="14" width="280" height="20" fill={accent} opacity=".35" /><rect x="40" y="34" width="240" height="8" fill="#fff" /><path d="M40 42h240" stroke="#f4d58d" stroke-width="3" /></g>
        : category.includes('stair') ? <path d="M60 160h40v-20h40v-20h40v-20h40v-20h40v-20" fill="none" stroke={wood} stroke-width="10" />
        : category.includes('door') ? <g><rect x="120" y="40" width="80" height="120" rx="3" fill={wood} /><circle cx="186" cy="102" r="4" fill="#d4c39a" /><rect x="132" y="52" width="56" height="40" fill={accent} opacity=".3" /></g>
        : category.includes('window') ? <g><rect x="80" y="30" width="160" height="96" fill="#cfe6f5" stroke={wood} stroke-width="8" /><rect x="70" y="126" width="180" height="22" rx="4" fill={accent} /></g>
        : <g>{Array.from({ length: 9 }, (_, i) => <rect x={40 + i * 27} y="30" width="20" height="128" rx="2" fill={accent} opacity={0.35 + (i % 3) * 0.2} />)}</g>}
    </g>
  )}
</svg>
