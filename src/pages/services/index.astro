---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SERVICES } from '../../lib/catalog';
---
<Base title="Home Services — Loans, Interiors, Legal, Moving" description="Home loans, interiors, property management, legal checks, inspection, packers and movers and more from verified partners.">
  <div class="container-x py-6">
    <Breadcrumbs items={[{ label: 'Services' }]} />
    <h1 class="mt-3 text-2xl font-extrabold sm:text-3xl">Home services</h1>
    <p class="text-slate-600">Everything after you find the home — handled by verified partners.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((s) => (
        <a href={`/services/${s.slug}`} class="card group p-6 transition hover:border-brand-300 hover:shadow-md">
          <span class="text-3xl" aria-hidden="true">{s.icon}</span>
          <p class="mt-3 text-lg font-bold group-hover:text-brand-700">{s.title}</p>
          <p class="text-sm text-slate-500">{s.sub}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
