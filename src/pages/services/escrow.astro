---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { EscrowRequest } from '../../components/islands/LegalOrders';

// See docs/functions/escrow/desc.md
const pillars = [
  ['🏦', 'Money stays with a bank', 'Funds sit in a dedicated escrow account with a regulated bank — not with the buyer, seller or broker.'],
  ['🤝', 'Released only on agreement', 'Money moves only when every party approves the release, as written in the escrow agreement.'],
  ['⚖', 'Independent trustee', 'A neutral trustee checks the conditions before any payout, so no single party can withdraw alone.'],
  ['⚡', 'Paperless', 'E-KYC, e-stamped agreement and e-signatures — set up an escrow without visiting an office.'],
];
const risks = [
  ['Failed transfers', 'No more token money lost in a bounced or reversed transfer.'],
  ['Fraud', 'Funds can’t be taken by someone who isn’t the verified seller.'],
  ['Deal falls through', 'If agreed conditions aren’t met, money goes back as per the agreement.'],
];
const stages = [
  { t: 'Create', steps: ['Add property details', 'Add buyer, seller and agent', 'Set amount and release conditions', 'Pay the escrow fee'] },
  { t: 'Fund', steps: ['All parties complete KYC', 'Everyone e-signs the agreement', 'Payer deposits into the escrow account'] },
  { t: 'Settle', steps: ['Any party requests release', 'All parties approve by e-sign', 'Trustee verifies and the beneficiary is paid'] },
];
const faq = [
  { q: 'What is an escrow service?', a: 'A neutral arrangement where money is held by a bank and released to the other party only when agreed conditions are met.' },
  { q: 'When should I use escrow for property?', a: 'For token or booking amounts, resale payments before registration, and large deposits — any time you are paying before you receive the property or documents.' },
  { q: 'How long does it take to set up?', a: 'Usually the same day once both parties finish KYC; the agreement itself is drafted in minutes.' },
  { q: 'Can I cancel an escrow?', a: 'Yes, if all parties agree. The money is returned to the payer as per the agreement.' },
  { q: 'Can one party withdraw money alone?', a: 'No. Every release needs the approvals set in the agreement plus the trustee’s check.' },
];
---
<Base title="Property Escrow — Pay Safely Until the Deal Closes" description="Hold token money or sale consideration in a bank escrow account and release it only when every party approves.">
  <section class="bg-brand-900 text-white">
    <div class="container-x grid gap-8 py-10 lg:grid-cols-[1fr_560px]">
      <div>
        <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: 'Escrow' }]} />
        <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">Digital escrow for property deals</h1>
        <p class="mt-2 max-w-xl text-white/80">Your money waits safely in a bank account until the deal is done. Released only when everyone agrees.</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">{pillars.map(([i, t, s]) => <div class="rounded-xl bg-white/10 p-4"><p class="font-semibold"><span aria-hidden="true">{i}</span> {t}</p><p class="mt-1 text-sm text-white/75">{s}</p></div>)}</div>
      </div>
      <div class="rounded-2xl bg-white p-5 text-neutral-800 shadow-xl">
        <h2 class="mb-3 text-lg font-bold">Start an escrow</h2>
        <EscrowRequest client:load />
      </div>
    </div>
  </section>
  <div class="container-x py-10">
    <h2 class="section-title mb-5">Risks it removes</h2>
    <div class="grid gap-4 md:grid-cols-3">{risks.map(([t, s]) => <div class="panel"><p class="font-bold text-brand-900">{t}</p><p class="mt-1 text-sm text-neutral-600">{s}</p></div>)}</div>
    <h2 class="section-title mb-5 mt-12">How it works</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {stages.map((s, i) => <div class="panel"><p class="eyebrow">Stage {i + 1}</p><p class="text-lg font-bold text-brand-900">{s.t}</p><ol class="mt-3 space-y-2 text-sm">{s.steps.map((x, j) => <li class="flex gap-2"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-accent-500 text-xs font-bold text-brand-900">{j + 1}</span>{x}</li>)}</ol></div>)}
    </div>
    <div class="panel mt-10"><Faq items={faq} /></div>
  </div>
</Base>
