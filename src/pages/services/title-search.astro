---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { TitleSearchOrder } from '../../components/islands/ServiceOrders';

const insights = [
  ['Title chain', 'Every recorded transfer of the property, so you can confirm the seller really owns it.'],
  ['Mortgage records', 'Loans and charges registered against the property that must be cleared before sale.'],
  ['Encumbrances', 'Court attachments, liens or claims recorded with the sub-registrar.'],
  ['Coverage', 'Search across 13 years of records (digital) or 30 years (lawyer-verified).'],
];
const steps = ['Share property details and pay securely', 'Our legal team searches sub-registrar and revenue records', 'Findings are verified and summarised', 'Receive your title report by email'];
const faq = [
  { q: 'What is a title search report?', a: 'A report that traces the ownership history of a property and lists any mortgages or encumbrances recorded against it.' },
  { q: 'Why do I need one?', a: 'It confirms the seller has the right to sell and that the property is free of loans or disputes before you pay a token or sign an agreement.' },
  { q: 'How long does it take?', a: 'A digital report usually takes 3–5 working days; a lawyer-verified 30-year report takes 7–10 working days depending on the state.' },
  { q: 'What does it cost?', a: 'Title searches typically cost 0.05%–0.15% of a property’s value; our fixed prices are shown on the form.' },
  { q: 'Which documents help?', a: 'Previous sale deeds, property tax receipts and the society share certificate speed things up, though they are not mandatory to order.' },
];
---
<Base title="Title Search — Property Ownership & Mortgage Check" description="Order a property title search report: ownership chain, mortgage records and encumbrances, from ₹1,500.">
  <div class="container-x py-6">
    <Breadcrumbs items={[{ label: 'Services', href: '/services' }, { label: 'Title Search' }]} />
    <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_520px]">
      <section class="panel">
        <p class="eyebrow">Legal services</p>
        <h1 class="mt-1 text-3xl font-bold">Title Search</h1>
        <p class="mt-2 text-neutral-600">Uncover the full ownership history and any loans on a property before you buy, lend or sell.</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {insights.map(([t, s]) => <div class="rounded-xl bg-brand-50 p-4"><p class="font-semibold text-brand-900">{t}</p><p class="mt-1 text-sm text-neutral-600">{s}</p></div>)}
        </div>
        <h2 class="mt-8 text-lg font-bold">How it works</h2>
        <ol class="mt-3 space-y-2">{steps.map((s, i) => <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-accent-500 text-sm font-bold text-brand-900">{i + 1}</span><span class="pt-0.5 text-sm">{s}</span></li>)}</ol>
      </section>
      <section class="panel h-fit">
        <h2 class="text-xl font-bold">New request</h2>
        <p class="mb-4 text-xs text-neutral-500">Fields marked * are mandatory</p>
        <TitleSearchOrder client:load />
      </section>
    </div>
    <div class="panel mt-6"><Faq items={faq} /></div>
  </div>
</Base>
