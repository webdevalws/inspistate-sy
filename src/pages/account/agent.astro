---
import Base from '../../layouts/Base.astro';
import AccountNav from '../../components/AccountNav.astro';
import ListerStats from '../../components/account/ListerStats.astro';
import MyListings from '../../components/account/MyListings.astro';
import LeadsReceived from '../../components/account/LeadsReceived.astro';
import { realPhone } from '../../lib/auth';
import { leadsReceived, listingAllowance, myListings, subscriptionState } from '../../lib/accounts';
import { getRefs } from '../../lib/repo';

// Agent dashboard: the agent's plan and listing allowance, their listings and the leads on them, built from the same
// sections as /account. Where agents land after logging in (landingFor in src/lib/redirect.ts). Other roles go to /account.
const user = Astro.locals.user!; // middleware redirects anonymous users to /login
if (user.role !== 'agent') return Astro.redirect('/account');
const [refs, listings, allowance, leads, subs] = await Promise.all([
  getRefs(), myListings(user.id), listingAllowance(user), leadsReceived(user.id), subscriptionState(user.id),
]);
const phone = realPhone(user.phone);
const listingDone = ({ sold: 'Listing marked sold.', rented: 'Listing marked rented.', deleted: 'Listing deleted.' } as Record<string, string>)[Astro.url.searchParams.get('listing') ?? ''];
---
<Base title="Agent dashboard" noindex>
  <div class="min-h-[70vh] bg-sand-100 text-[#1C1A17]">
    <div class="container-x grid gap-8 py-8 lg:grid-cols-[260px_1fr] lg:py-12">
      <AccountNav user={user} active="agent" />

      <div class="min-w-0 space-y-12">
        <section>
          <p class="ed-label text-[#1C1A17]/60">Agent dashboard</p>
          <h1 class="mt-3 font-display text-[clamp(1.8rem,3.5vw,2.6rem)] font-bold leading-[1.04] tracking-[-0.02em] !text-[#1C1A17]">{user.company ?? 'Your agency'}</h1>
          <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.16em] text-[#1C1A17]/55">{user.name}{phone && ` · +91 ${phone}`}{user.city_slug && ` · ${refs.city(user.city_slug)?.name ?? ''}`}</p>

          {!phone && (
            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-[0.5px] border-amber-400 bg-amber-50 p-5">
              <p class="text-sm">Add your mobile number to post listings and get enquiries from buyers.</p>
              <a href="/account#profile" class="ed-btn ed-btn-dark">Add mobile number →</a>
            </div>
          )}

          <ListerStats user={user} allowance={allowance} leadsCount={leads.length} subs={subs} />

          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/post-property" class:list={['ed-btn', allowance.canPost ? 'ed-btn-dark' : 'ed-btn-ghost-dark pointer-events-none opacity-50']}>+ List property</a>
            <a href="/account/plans" class="ed-btn ed-btn-ghost-dark">Subscription plans</a>
          </div>
        </section>

        <MyListings listings={listings} refs={refs} listingDone={listingDone} back="/account/agent" />

        <LeadsReceived leads={leads} hasPlan={allowance.hasPlan} />
      </div>
    </div>
  </div>
</Base>
