---
import Base from '../../layouts/Base.astro';
import AccountNav from '../../components/AccountNav.astro';
import { subscriptionState, listingAllowance } from '../../lib/accounts';
import { PLANS, PLAN_FEATURES, FREE_LISTINGS, planByKey } from '../../data/plans';

const user = Astro.locals.user!; // middleware redirects anonymous users to /login
const isAgent = user.role === 'agent';
const [subs, allowance] = isAgent ? await Promise.all([subscriptionState(user.id), listingAllowance(user)]) : [null, null];
const requested = Astro.url.searchParams.get('requested');
const error = Astro.url.searchParams.get('error');
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const rupees = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const active = subs?.active ? planByKey(subs.active.plan) : null;
const pending = subs?.requested ? planByKey(subs.requested.plan) : null;
const ICON = {
  crown: 'M3 8l4.5 4L12 5l4.5 7L21 8l-2 11H5z',
  gem: 'M6 3h12l4 6-10 12L2 9zM2 9h20M9 3l3 18M15 3l-3 18',
};
---
<Base title="Subscription plans" noindex>
  <div class="min-h-[70vh] bg-sand-100 text-[#1C1A17]">
    <div class="container-x grid gap-8 py-8 lg:grid-cols-[260px_1fr] lg:py-12">
      <AccountNav user={user} active="plans" />

      <div class="min-w-0">
        <p class="ed-label text-[#1C1A17]/60"><span class="bracket"></span>For agents</p>
        <h1 class="mt-3 font-display text-[clamp(1.8rem,3.5vw,2.6rem)] font-bold leading-[1.04] tracking-[-0.02em] !text-[#1C1A17]">Available Plans</h1>
        <p class="mt-2 max-w-xl text-sm text-[#1C1A17]/65">Every agent account starts with {FREE_LISTINGS.agent} free listings. A plan removes the limit and unlocks buyer contact details on all your leads.</p>

        {requested && <p class="mt-6 border-[0.5px] border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Request received. Our team will call you on +91 {user.phone} to complete payment and activate your plan.</p>}
        {error && <p class="mt-6 border-[0.5px] border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">{error === 'agent' ? 'Plans are available on Agent accounts.' : error}</p>}

        {!isAgent ? (
          <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-[0.5px] border-[#1C1A17]/15 bg-white p-6">
            <div>
              <p class="font-display text-lg font-bold">Plans are for real-estate agents</p>
              <p class="text-sm text-[#1C1A17]/60">Switch your account type to Agent to list without limits.</p>
            </div>
            <form method="post" action="/api/account/role"><input type="hidden" name="role" value="agent" /><input type="hidden" name="back" value="/account/plans" /><button class="ed-btn ed-btn-dark">Switch to agent →</button></form>
          </div>
        ) : (
          <>
            {(active || pending) && (
              <div class="mt-6 grid border-[0.5px] border-[#1C1A17]/15 bg-white sm:grid-cols-2">
                <div class="p-5">
                  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#1C1A17]/55">Current plan</p>
                  <p class="mt-2 font-display text-xl font-bold">{active ? active.name : 'Free'}</p>
                  <p class="text-sm text-[#1C1A17]/60">{active && subs?.active?.ends_at ? `Active till ${fmtDate(subs.active.ends_at)}` : `${allowance?.used ?? 0} of ${FREE_LISTINGS.agent} free listings used`}</p>
                </div>
                {pending && (
                  <div class="border-t-[0.5px] border-[#1C1A17]/15 p-5 sm:border-l-[0.5px] sm:border-t-0">
                    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#1C1A17]/55">Request in progress</p>
                    <p class="mt-2 font-display text-xl font-bold">{pending.name}</p>
                    <p class="text-sm text-[#1C1A17]/60">Requested {fmtDate(subs!.requested!.created_at)} · our team will call you</p>
                  </div>
                )}
              </div>
            )}

            <div class="mt-8 grid gap-5 md:grid-cols-2 xl:max-w-4xl">
              {PLANS.map((p) => {
                const isActive = active?.key === p.key;
                const isPending = pending?.key === p.key;
                return (
                  <article class:list={['flex flex-col border-[0.5px] bg-white', isActive ? 'border-accent-500 ring-1 ring-accent-500' : 'border-[#1C1A17]/15']}>
                    <header class="flex items-start justify-between gap-4 bg-[#1C1A17] p-5 text-sand-50">
                      <div class="flex items-center gap-3">
                        <svg viewBox="0 0 24 24" class="h-7 w-7 text-accent-300" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d={ICON[p.icon]} /></svg>
                        <div>
                          <h2 class="font-display text-lg font-bold !text-sand-50">{p.name}</h2>
                          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-sand-50/55">{p.months} months</p>
                        </div>
                      </div>
                      <div class="text-right">
                        <p><span class="mr-1.5 text-sm text-sand-50/50 line-through">{rupees(p.mrp)}</span><span class="font-display text-2xl font-bold">{rupees(p.price)}</span></p>
                        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-accent-300">{rupees(Math.round(p.price / p.months))} / month · save {Math.round((1 - p.price / p.mrp) * 100)}%</p>
                      </div>
                    </header>
                    <ul class="flex-1 space-y-3 p-5">
                      {PLAN_FEATURES.map((f) => (
                        <li class="flex items-center gap-3 text-sm">
                          <span class="grid h-5 w-5 shrink-0 place-items-center bg-accent-100 text-[11px] text-accent-800" aria-hidden="true">✓</span>{f}
                        </li>
                      ))}
                    </ul>
                    <div class="p-5 pt-0">
                      {isActive ? (
                        <p class="ed-btn w-full border-accent-500 bg-accent-50 text-accent-800">Your current plan</p>
                      ) : isPending ? (
                        <p class="ed-btn w-full border-[#1C1A17]/25 text-[#1C1A17]/60">Request in progress</p>
                      ) : (
                        <form method="post" action="/api/account/subscription">
                          <input type="hidden" name="plan" value={p.key} />
                          <button class="ed-btn ed-btn-dark w-full" disabled={!!pending}>Proceed to buy →</button>
                        </form>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
            <p class="mt-6 max-w-2xl text-xs leading-relaxed text-[#1C1A17]/55">Online payment is coming soon. For now, “Proceed to buy” sends your request to our team, who will call you to complete payment and switch the plan on — usually the same working day.</p>
          </>
        )}
      </div>
    </div>
  </div>
</Base>
