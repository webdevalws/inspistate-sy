---
import Base from '../layouts/Base.astro';
import AccountNav from '../components/AccountNav.astro';
import ShortlistView from '../components/islands/ShortlistView';
import SavedSearchList from '../components/islands/SavedSearchList';
import AddPhone from '../components/islands/AddPhone';
import ListerStats from '../components/account/ListerStats.astro';
import MyListings from '../components/account/MyListings.astro';
import LeadsReceived from '../components/account/LeadsReceived.astro';
import { fmtDate, h2 } from '../components/account/shared';
import { realPhone } from '../lib/auth';
import { GOOGLE_ERRORS, googleEnabled } from '../lib/google';
import { leadsReceived, listingAllowance, myEnquiries, myListings, savedSearches, subscriptionState } from '../lib/accounts';
import { getRefs } from '../lib/repo';
import { safeNext } from '../lib/redirect';
import { ROLES, roleLabel } from '../data/plans';

const user = Astro.locals.user!; // middleware redirects anonymous users to /login
const lister = user.role === 'seller' || user.role === 'agent';
const [refs, listings, enquiries, searches, allowance, leads, subs] = await Promise.all([
  getRefs(), myListings(user.id), myEnquiries(user.id), savedSearches(user.id), listingAllowance(user),
  lister ? leadsReceived(user.id) : Promise.resolve([]), user.role === 'agent' ? subscriptionState(user.id) : Promise.resolve(null),
]);
const saved = Astro.url.searchParams.get('saved');
// Accounts created with Google have no mobile number until they add one (sellers and agents need it to post).
const phone = realPhone(user.phone);
const phoneAdded = Astro.url.searchParams.get('phone') === 'added';
// Linking Google from here: /api/auth/google/callback comes back with ?google=linked or an error code.
const googleParam = Astro.url.searchParams.get('google') ?? '';
const googleError = Object.hasOwn(GOOGLE_ERRORS, googleParam) ? GOOGLE_ERRORS[googleParam] : '';
// Result of an owner action (/api/account/listings/[id] redirects back with ?listing=…).
const listingDone = ({ sold: 'Listing marked sold.', rented: 'Listing marked rented.', deleted: 'Listing deleted.', 'agents-on': 'Agents can now see this listing and offer to help.', 'agents-off': 'This listing is no longer shown to agents.' } as Record<string, string>)[Astro.url.searchParams.get('listing') ?? ''];
---
<Base title="My account" noindex>
  <div class="min-h-[70vh] bg-sand-100 text-[#1C1A17]">
    <div class="container-x grid gap-8 py-8 lg:grid-cols-[260px_1fr] lg:py-12">
      <AccountNav user={user} active="overview" />

      <div class="min-w-0 space-y-12">
        {/* Overview */}
        <section>
          <p class="ed-label text-[#1C1A17]/60">{user.role ? `${roleLabel(user.role)} account` : 'Welcome'}</p>
          <h1 class="mt-3 font-display text-[clamp(1.8rem,3.5vw,2.6rem)] font-bold leading-[1.04] tracking-[-0.02em] !text-[#1C1A17]">Hello{user.name ? `, ${user.name.split(' ')[0]}` : ''}.</h1>
          <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.16em] text-[#1C1A17]/55">{phone ? `+91 ${phone}` : 'No mobile number yet'}{user.city_slug && ` · ${refs.city(user.city_slug)?.name ?? ''}`}</p>

          {!user.role && (
            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-[0.5px] border-amber-400 bg-amber-50 p-5">
              <p class="text-sm">Finish creating your account — tell us whether you are a <b>Buyer</b>, <b>Seller</b> or <b>Agent</b>.</p>
              <a href="/login" data-auth-open class="ed-btn ed-btn-dark">Finish registration →</a>
            </div>
          )}
          {lister && !phone && (
            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-[0.5px] border-amber-400 bg-amber-50 p-5">
              <p class="text-sm">Add your mobile number to post listings and get enquiries from buyers.</p>
              <a href="#profile" class="ed-btn ed-btn-dark">Add mobile number →</a>
            </div>
          )}

          {lister && (
            <ListerStats user={user} allowance={allowance} leadsCount={leads.length} subs={subs} />
          )}

          {user.role === 'user' && (
            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-[0.5px] border-[#1C1A17]/15 bg-white p-5">
              <div>
                <p class="font-display text-lg font-bold">Want to sell or rent out a property?</p>
                <p class="text-sm text-[#1C1A17]/60">Switch to a Seller account and get 3 free listings.</p>
              </div>
              <form method="post" action="/api/account/role"><input type="hidden" name="role" value="seller" /><input type="hidden" name="back" value="/post-property" /><button class="ed-btn ed-btn-dark">Become a seller →</button></form>
            </div>
          )}
        </section>

        {lister && (
          <MyListings listings={listings} refs={refs} listingDone={listingDone} agents={user.role === 'seller'} />
        )}

        {lister && (
          <LeadsReceived leads={leads} hasPlan={allowance.hasPlan} />
        )}

        <section id="shortlist" class="scroll-mt-28">
          <h2 class={`${h2} mb-4`}>Shortlist</h2>
          <ShortlistView client:load />
        </section>

        <section id="searches" class="scroll-mt-28">
          <h2 class={`${h2} mb-4`}>Saved Searches</h2>
          <SavedSearchList client:visible initial={searches.map((s) => ({ id: s.id, label: s.label, url: s.url, created: fmtDate(s.created_at) }))} />
        </section>

        <section id="enquiries" class="scroll-mt-28">
          <h2 class={`${h2} mb-4`}>My Enquiries</h2>
          {enquiries.length ? (
            <ul class="border-t-[0.5px] border-[#1C1A17]/15">
              {enquiries.map((e) => <li class="flex flex-wrap items-center justify-between gap-2 border-b-[0.5px] border-[#1C1A17]/15 bg-white px-4 py-3 text-sm"><span>{safeNext(e.page) ? <a href={safeNext(e.page)!} class="font-medium underline">{e.subject}</a> : e.subject} <span class="ml-1 font-mono text-[10px] uppercase tracking-[0.14em] text-[#1C1A17]/50">{e.kind.replace('-', ' ')}</span></span><span class="text-[#1C1A17]/55">{fmtDate(e.created_at)}</span></li>)}
            </ul>
          ) : <p class="text-sm text-[#1C1A17]/60">Enquiries you send while logged in appear here.</p>}
          <p class="mt-4 text-sm text-[#1C1A17]/70">Know someone buying, selling or renting? <a href="/refer" class="font-semibold underline">Refer a friend</a> — referrals you send appear in this list.</p>
        </section>

        <section id="profile" class="scroll-mt-28">
          <h2 class={`${h2} mb-4`}>Profile</h2>
          {saved && <p class="mb-3 border-[0.5px] border-emerald-300 bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Profile saved.</p>}
          {phoneAdded && phone && <p class="mb-3 border-[0.5px] border-emerald-300 bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Mobile number +91 {phone} added. You can also log in with it now.</p>}
          {!phone && (
            <div id="phone" class="mb-4">
              <p class="mb-2 text-sm text-[#1C1A17]/70">Add your mobile number{lister ? ' — needed to post listings and get enquiries' : ''}. We’ll send a code to check it.</p>
              <AddPhone client:visible />
            </div>
          )}
          <form method="post" action="/api/account/profile" class="grid gap-4 border-[0.5px] border-[#1C1A17]/15 bg-white p-5 sm:grid-cols-3 sm:items-end">
            <label class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#1C1A17]/60">Name<input name="name" maxlength="100" value={user.name ?? ''} class="input mt-1.5 rounded-none font-sans text-[15px] normal-case tracking-normal" /></label>
            <label class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#1C1A17]/60">Email<input name="email" type="email" maxlength="200" value={user.email ?? ''} class="input mt-1.5 rounded-none font-sans text-[15px] normal-case tracking-normal" /></label>
            <button class="ed-btn ed-btn-dark">Save</button>
          </form>
          {(user.google_email || googleEnabled()) && (
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-[0.5px] border-[#1C1A17]/15 bg-white p-5">
              {googleParam === 'linked' && user.google_email && <p class="w-full border-[0.5px] border-emerald-300 bg-emerald-50 px-3 py-2 text-sm text-emerald-800">Google account linked.</p>}
              {googleError && <p class="w-full border-[0.5px] border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-800">{googleError}</p>}
              {user.google_email ? (
                <p class="text-sm">Google account <b>{user.google_email}</b> — you can log in with Google{realPhone(user.phone) ? ' or your mobile number' : ''}.</p>
              ) : (
                <>
                  <p class="text-sm">Link your Google account to log in with Google too.</p>
                  <a href={`/api/auth/google/start?next=${encodeURIComponent('/account?google=linked#profile')}`} class="ed-btn ed-btn-ghost-dark">Continue with Google</a>
                </>
              )}
            </div>
          )}
          {user.role && (
            <form method="post" action="/api/account/role" class="mt-4 flex flex-wrap items-end gap-3 border-[0.5px] border-[#1C1A17]/15 bg-white p-5">
              <input type="hidden" name="back" value="/account#profile" />
              <label class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#1C1A17]/60">Account type
                <select name="role" class="input mt-1.5 min-w-48 rounded-none font-sans text-[15px] normal-case tracking-normal">
                  {ROLES.map((r) => <option value={r.key} selected={r.key === user.role}>{r.label} — {r.sub}</option>)}
                </select>
              </label>
              <button class="ed-btn ed-btn-ghost-dark">Change type</button>
            </form>
          )}
        </section>
      </div>
    </div>
  </div>
</Base>
