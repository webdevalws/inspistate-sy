---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getRefs } from '../../../lib/repo';
import { GUIDE_THEMES, type GuideTheme } from '../../../lib/community';
import { formatRate } from '../../../lib/format';
import { searchUrl } from '../../../lib/urls';

const refs = await getRefs();
const city = refs.city(Astro.params.city!);
const theme = Astro.params.theme as GuideTheme;
if (!city || !(theme in GUIDE_THEMES)) return new Response(null, { status: 404 });
const t = GUIDE_THEMES[theme];
const ranked = [...refs.localitiesOf(city.slug)].sort((a, b) => t.score(b) - t.score(a));
---
<Base title={`${t.title} in ${city.name}`} description={`${t.title} in ${city.name}: ${t.blurb} Ranked with live InspiState data.`}>
  <div class="container-x py-6">
    <Breadcrumbs items={[{ label: city.name, href: `/city/${city.slug}` }, { label: 'Locality guides' }, { label: t.title }]} />
    <h1 class="mt-3 text-2xl font-extrabold sm:text-3xl">{t.title} in {city.name}</h1>
    <p class="text-slate-600">{t.blurb}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {(Object.keys(GUIDE_THEMES) as GuideTheme[]).map((k) => <a href={`/localities/${city.slug}/${k}`} class:list={['rounded-full px-4 py-2 text-sm font-semibold', k === theme ? 'bg-brand-600 text-white' : 'bg-white ring-1 ring-slate-200 hover:text-brand-700']}>{GUIDE_THEMES[k].title}</a>)}
    </div>
    <ol class="mt-6 space-y-3">
      {ranked.map((l, i) => (
        <li class="card flex flex-col gap-3 p-5 sm:flex-row sm:items-center">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-50 text-lg font-extrabold text-brand-700">{i + 1}</span>
          <div class="flex-1">
            <a href={`/locality/${city.slug}/${l.slug}`} class="text-lg font-bold hover:text-brand-700">{l.name}</a>
            <p class="text-sm text-slate-500">{formatRate(l.ratePerSqft)} · rent ₹{l.rentPerSqft}/sq.ft · ▲{l.yoyGrowthPct}% YoY · yield {((l.rentPerSqft * 12 * 100) / l.ratePerSqft).toFixed(1)}%</p>
          </div>
          <div class="flex gap-2"><a href={searchUrl('buy', city.slug, l.slug)} class="btn-ghost py-2">Buy</a><a href={searchUrl('rent', city.slug, l.slug)} class="btn-ghost py-2">Rent</a></div>
        </li>
      ))}
    </ol>
  </div>
</Base>
