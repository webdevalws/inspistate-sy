---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import ReferralForm from '../components/islands/ReferralForm';
import { getRefs } from '../lib/repo';
import { currentCity } from '../lib/city';

// Refer a friend. Referrals are saved as 'referral' leads through /api/enquiry; no rewards are paid out on
// the site. See docs/functions/refer/desc.md.
const { cities } = await getRefs();
const city = currentCity(Astro.url, Astro.cookies, cities);
const who = [
  { icon: '🔑', t: 'A buyer', s: 'Someone looking for a home or an investment property.' },
  { icon: '🏷', t: 'A seller', s: 'An owner who wants to sell a flat, house or plot.' },
  { icon: '🧳', t: 'A tenant', s: 'Someone moving to a new city or looking for a rental or PG.' },
  { icon: '🏠', t: 'An owner', s: 'A landlord who wants to rent out a property, or have it managed.' },
];
const steps = ['Tell us who you’re referring and what they need', 'Our team calls your friend and helps them', 'If the referral meets the terms, we get in touch with you'];
const terms = [
  'Rewards, if any, are subject to these terms and are decided by InspiState. No reward is paid out through this website.',
  'Refer only people who know about the referral and are happy to be contacted.',
  'A referral counts only if the friend is not already in touch with InspiState for the same need.',
  'Referring yourself, or submitting false or repeated referrals, is not allowed.',
];
const faq = [
  { q: 'What happens after I refer someone?', a: 'Our team calls your friend, understands what they need and helps them buy, sell, rent or let out. We may call you to confirm details.' },
  { q: 'Do I get a reward?', a: 'Any reward is subject to the referral terms on this page and is confirmed by our team. Nothing is paid out automatically through the website.' },
  { q: 'Will my friend’s details be shared?', a: 'No. We use them only to contact your friend about this referral.' },
  { q: 'Do I need an account?', a: 'No. Anyone can refer; if you are logged in, the referral also appears under My Enquiries in your account.' },
];
---
<Base title="Refer a Friend" description="Know someone buying, selling, renting or letting out a property? Refer them to InspiState in a minute.">
  <section class="bg-brand-900 text-white">
    <div class="container-x grid gap-8 py-12 lg:grid-cols-[1fr_560px] lg:items-start">
      <div>
        <Breadcrumbs items={[{ label: 'Refer a friend' }]} />
        <h1 class="mt-4 max-w-2xl font-serif text-4xl font-bold text-white sm:text-5xl">Know someone moving? <span class="text-accent-400">Refer them.</span></h1>
        <p class="mt-3 max-w-xl text-white/80">If a friend, colleague or family member wants to buy, sell, rent or let out a property, share their details and our team will help them.</p>
        <ol class="mt-6 space-y-2">{steps.map((s, i) => <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/15 text-sm font-bold">{i + 1}</span><span class="pt-0.5">{s}</span></li>)}</ol>
      </div>
      <div class="rounded-2xl bg-white p-5 text-slate-800 shadow-xl">
        <h2 class="mb-3 text-lg font-bold">Refer a friend</h2>
        <ReferralForm client:load cities={cities.map((c) => ({ slug: c.slug, name: c.name }))} city={city.slug} />
      </div>
    </div>
  </section>
  <div class="container-x py-10">
    <h2 class="section-title mb-4">Who you can refer</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {who.map((w) => <div class="panel"><span class="text-2xl" aria-hidden="true">{w.icon}</span><p class="mt-2 font-bold text-brand-900">{w.t}</p><p class="mt-1 text-sm text-neutral-600">{w.s}</p></div>)}
    </div>

    <h2 id="terms" class="section-title mb-4 mt-12 scroll-mt-28">Referral terms</h2>
    <ul class="panel space-y-2 text-sm text-neutral-700">{terms.map((t) => <li class="flex gap-2"><span class="text-accent-600">•</span>{t}</li>)}</ul>

    <div class="panel mt-12"><Faq items={faq} /></div>
  </div>
</Base>
