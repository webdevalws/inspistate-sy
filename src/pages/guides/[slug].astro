---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { GUIDES } from '../../data/guides';

const g = GUIDES.find((x) => x.slug === Astro.params.slug);
if (!g) return new Response(null, { status: 404 });
const others = GUIDES.filter((x) => x.slug !== g.slug).slice(0, 3);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: g.title, description: g.summary, publisher: { '@type': 'Organization', name: 'InspiState' } };
---
<Base title={g.title} description={g.summary} jsonLd={jsonLd}>
  <article class="container-x max-w-3xl py-6">
    <Breadcrumbs items={[{ label: 'Guides', href: '/guides' }, { label: g.title }]} />
    <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-brand-700">{g.audience} · {g.readMins} min read</p>
    <h1 class="mt-1 text-3xl font-extrabold leading-tight">{g.title}</h1>
    <p class="mt-3 text-lg text-slate-600">{g.summary}</p>
    <nav class="card mt-6 p-5" aria-label="Contents">
      <p class="text-sm font-semibold">In this guide</p>
      <ol class="mt-2 list-inside list-decimal space-y-1 text-sm">{g.sections.map((s, i) => <li><a href={`#s${i}`} class="text-brand-700 hover:underline">{s.heading}</a></li>)}</ol>
    </nav>
    {g.sections.map((s, i) => (
      <section id={`s${i}`} class="mt-8 scroll-mt-24">
        <h2 class="text-xl font-bold">{s.heading}</h2>
        {s.body?.map((p) => <p class="mt-3 leading-relaxed text-slate-700">{p}</p>)}
        {s.bullets && <ul class="mt-3 list-disc space-y-1.5 pl-5 text-slate-700">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
      </section>
    ))}
    <aside class="mt-12 rounded-2xl bg-brand-50 p-6">
      <p class="font-semibold">Useful tools</p>
      <div class="mt-3 flex flex-wrap gap-2">{[['EMI calculator', '/tools/emi-calculator'], ['Affordability', '/tools/affordability'], ['Stamp duty', '/tools/stamp-duty'], ['Capital gains', '/tools/capital-gains']].map(([l, h]) => <a href={h} class="btn-ghost py-2">{l}</a>)}</div>
    </aside>
    <section class="mt-12">
      <h2 class="mb-4 text-lg font-bold">Keep reading</h2>
      <div class="grid gap-3 sm:grid-cols-3">{others.map((o) => <a href={`/guides/${o.slug}`} class="card p-4 hover:border-brand-300"><p class="text-sm font-semibold">{o.title}</p><p class="mt-1 text-xs text-slate-500">{o.readMins} min</p></a>)}</div>
    </section>
  </article>
</Base>
