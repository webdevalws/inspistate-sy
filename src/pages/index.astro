---
import Base from '../layouts/Base.astro';
import EdHead from '../components/EdHead.astro';
import Tabs from '../components/Tabs.astro';
import Stars from '../components/Stars.astro';
import MiniLine from '../components/MiniLine.astro';
import MiniBars from '../components/MiniBars.astro';
import SearchBox from '../components/islands/SearchBox';
import LeadDialog from '../components/islands/LeadDialog';
import ShortlistButton from '../components/islands/ShortlistButton';
import { cityStats, getProjects, getRefs, platformTotals } from '../lib/repo';
import { homeInsights, homeMarket } from '../lib/community';
import { searchBoxProps } from '../lib/searchProps';
import { formatNumber, formatPrice, formatRange } from '../lib/format';
import { builderUrl, projectUrl, searchUrl } from '../lib/urls';
import { currentCity } from '../lib/city';

const refs = await getRefs();
const { cities, builders } = refs;
const [projects, statsFor, sb, totals, ins, mkt] = await Promise.all([
  getProjects({}, { orderBy: 'newest' }), cityStats(), searchBoxProps(), platformTotals(), homeInsights(), homeMarket(),
]);
// Cities for the market-insight and locality tabs: the first 8, plus every city added after the original ten
// demo cities (Lucknow, Navi Mumbai…) that has projects, since the insight charts need them.
const ORIGINAL_CITIES = 10;
const topCities = [...cities.slice(0, 8), ...cities.slice(ORIGINAL_CITIES).filter((c) => projects.some((p) => p.citySlug === c.slug))];
const pct = (a: number, b: number) => (a ? ((b - a) / a) * 100 : 0);

// Market-insight series per city, all from our own data.
const insight = (slug: string) => {
  const ps = projects.filter((p) => p.citySlug === slug);
  const trend = ps.length ? ps[0].priceTrend.map((pt, i) => ({ label: pt.label.replace(' 20', " '"), v: ps.reduce((s, p) => s + p.priceTrend[i].rate, 0) / ps.length })) : [];
  const yields = refs.localitiesOf(slug).map((l) => ({ label: l.name.split(' ')[0], n: +(((l.rentPerSqft * 12) / l.ratePerSqft) * 100).toFixed(1) })).slice(0, 6);
  const tx = mkt.txQuarters(slug).slice(-6);
  return {
    trend, yields, tx,
    movement: trend.length ? pct(trend[3].v, trend[7].v) : 0,
    growth: trend.length ? pct(trend[0].v, trend[7].v) : 0,
    avgYield: yields.length ? yields.reduce((s, y) => s + y.n, 0) / yields.length : 0,
    txGrowth: tx.length > 1 ? pct(tx[0].v, tx.at(-1)!.v) : 0,
  };
};

const guideCards = [
  { title: 'Home Buying Guide', sub: 'Step by step guide to buy your dream home', href: '/guides/buyer-guide', bg: 'from-sky-50 to-sky-100', icon: 'M4 21V10l8-6 8 6v11H4ZM9 21v-6h6v6' },
  { title: 'Home Loan Guide', sub: 'Compare loans & get the best rates', href: '/guides/home-loan-basics', bg: 'from-indigo-50 to-indigo-100', icon: 'M6 3h9l3 3v15H6zM9 12h6M9 16h6M9 8h3' },
  { title: 'Investment Guide', sub: 'Best locations for high returns', href: '/localities/mumbai/rental-yield', bg: 'from-violet-50 to-violet-100', icon: 'M3 20h18M6 16l4-5 3 3 5-7' },
  { title: 'Legal & Documentation', sub: 'Know the complete process', href: '/guides/rera-explained', bg: 'from-purple-50 to-purple-100', icon: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6' },
];

// "Discover more" tabs: each card is a category in a city with its starting price.
const c = (i: number) => topCities[i % topCities.length];
type Card = { title: string; img: string; city: (typeof cities)[number]; href: string; min: number | null };
const card = (title: string, img: string, cityIdx: number, href: (s: string) => string, pred: Parameters<typeof mkt.from>[0]): Card => {
  const city = c(cityIdx);
  return { title, img, city, href: href(city.slug), min: mkt.from(pred, city.slug)?.min ?? null };
};
const discover: { tab: string; cards: Card[] }[] = [
  { tab: 'Residential', cards: [
    card('2 BHK Luxury Apartments', 'apartment-luxury-sea.jpg', 1, (s) => searchUrl('buy', s, '2-bhk', 'apartment'), (r) => r.type === 'Apartment' && r.bhk === 2),
    card('3 BHK Sky Residences', 'interior-luxury-living.jpg', 0, (s) => searchUrl('buy', s, '3-bhk', 'apartment'), (r) => r.type === 'Apartment' && r.bhk === 3),
    card('4 BHK Signature Penthouses', 'project-luxury-tower.jpg', 2, (s) => searchUrl('buy', s, '4-bhk', 'apartment'), (r) => r.type === 'Apartment' && r.bhk === 4),
    card('Waterfront Luxury Villas', 'project-luxury-villa.jpg', 5, (s) => searchUrl('buy', s, 'villa'), (r) => r.type === 'Villa'),
    card('Prime Residential Plots', 'plot.svg', 6, (s) => searchUrl('buy', s, 'plot'), (r) => r.type === 'Plot'),
  ] },
  { tab: 'Commercial', cards: [0, 1, 2, 3, 4].map((i) => card(i % 2 ? 'Grade-A Retail Shops' : 'Corporate Office Suites', 'commercial-luxury-tower.jpg', i, (s) => `${searchUrl('commercial', s, i % 2 ? 'shop' : 'office')}?for=buy`, (r) => r.type === (i % 2 ? 'Shop' : 'Office'))) },
  { tab: 'Plots & Land', cards: [0, 1, 2, 3, 4].map((i) => card('Gated Community Plots', 'plot.svg', i, (s) => searchUrl('buy', s, 'plot'), (r) => r.type === 'Plot')) },
  { tab: 'Villas', cards: [0, 1, 2, 3, 4].map((i) => card('Contemporary Luxury Villas', 'project-luxury-villa.jpg', i, (s) => searchUrl('buy', s, 'villa'), (r) => r.type === 'Villa')) },
  { tab: 'Builder Floors', cards: [0, 1, 2, 3, 4].map((i) => card('Designer Builder Floors', 'interior-luxury-living.jpg', i, (s) => searchUrl('buy', s, 'builder-floor'), (r) => r.type === 'Builder Floor')) },
];

// Landing page photo pool (all our own images).
const photos = ['/images/hero-luxury.jpg', '/images/apartment-luxury-sea.jpg', '/images/project-luxury-tower.jpg', '/images/interior-luxury-living.jpg', '/images/project-luxury-villa.jpg', '/images/commercial-luxury-tower.jpg'];
const caption = (m: Card) => `${m.city.name}${m.min ? ` · From ${formatPrice(m.min)}` : ''}`;

// Collections bento: six tiles that exactly fill a 4×3 grid (2×N on mobile).
const [r2, r3, r4, villas, , ] = discover[0].cards;
const collections = [
  { m: r3, img: photos[0], span: 'col-span-2 row-span-2' },
  { m: r2, img: photos[1], span: '' },
  { m: r4, img: photos[2], span: 'row-span-2' },
  { m: discover[4].cards[0], img: photos[3], span: '' },
  { m: villas, img: photos[4], span: 'col-span-2' },
  { m: discover[1].cards[0], img: photos[5], span: 'col-span-2' },
].map(({ m, img, span }) => ({ title: m.title, href: m.href, img, span, sub: caption(m) }));
const moreCollections = [discover[0].cards[4], discover[1].cards[1], discover[2].cards[0], discover[3].cards[1]].map((m) => ({ title: `${m.title} · ${m.city.name}`, href: m.href }));

const hotProjects = projects.slice(0, 5).map((p, i) => ({
  id: p.id, name: p.name, href: projectUrl(p), img: photos[(i + 2) % photos.length], status: p.status,
  locality: refs.locality(p.citySlug, p.localitySlug)?.name ?? '', city: refs.city(p.citySlug)?.name ?? '',
  price: formatRange(p.priceMin, p.priceMax), meta: `${p.bhkLabel} · ${p.possession}`,
}));

const toolTiles = [
  { title: 'Home Loan Calculator', sub: 'Calculate EMI & affordability', href: '/tools/loan-eligibility', icon: 'M4 4h16v16H4zM8 8h3v3H8zM13 8h3M13 11h3M8 15h8' },
  { title: 'Property Value Calculator', sub: 'Check current market value', href: '/tools/property-valuation', icon: 'M4 20V10l8-6 8 6v10zM9 14h6M12 11v6' },
  { title: 'Rental Yield Finder', sub: 'Know your rental returns', href: '/localities/mumbai/rental-yield', icon: 'M4 20V10l8-6 8 6v10zM9 20v-5h6v5' },
  { title: 'Stamp Duty Calculator', sub: 'Estimate your stamp duty', href: '/tools/stamp-duty', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 8v5M12 16h.01' },
  { title: 'EMI Calculator', sub: 'Plan your finances', href: '/tools/emi-calculator', icon: 'M6 3h12v18H6zM9 7h6M9 11h2M13 11h2M9 15h2M13 15h2' },
];
---
<Base title="InspiState — Search, Compare & Own Your Next Home" description="Search verified homes for sale and rent, new launch projects and commercial spaces across India. Property rates, price trends, valuation, home loans and free tools.">
  <!-- Hero: layered depth — photo, giant wordmark, then the building cut-out in front of it -->
  <section id="hero" class="hero relative min-h-[100svh] overflow-hidden bg-[#2b231d] text-sand-50">
    <picture>
      <source media="(orientation: portrait)" srcset="/images/hero-towers-portrait-bg.webp" />
      <img src="/images/hero-towers-bg.webp" alt="" aria-hidden="true" fetchpriority="high" class="hero-photo hero-layer absolute inset-0 h-full w-full object-cover" data-depth="0.06" />
    </picture>
    <div class="absolute inset-0 bg-[#b48b5d] opacity-60 mix-blend-color pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#1C1A17]/45 via-[#e9d8bd]/10 to-transparent pointer-events-none"></div>

    <div aria-hidden="true" class="hero-wordmark-wrap hero-layer absolute inset-x-0 z-[1] select-none text-center" data-depth="0.22">
      <span class="hero-wordmark block font-display font-extrabold uppercase leading-[0.8] text-sand-50/90">InspiState</span>
    </div>

    <picture>
      <source media="(orientation: portrait)" srcset="/images/hero-towers-portrait-cut.webp" />
      <img src="/images/hero-towers-cut.webp" alt="Three residential towers against a dusk sky" class="hero-photo hero-cut hero-layer absolute inset-0 z-[2] h-full w-full object-cover" data-depth="0.06" />
    </picture>

    <div class="absolute inset-x-0 bottom-0 z-[3] h-[58%] bg-gradient-to-t from-[#1C1A17]/90 via-[#1C1A17]/40 to-transparent pointer-events-none"></div>

    <div class="hero-content container-x relative z-[4] flex min-h-[100svh] flex-col justify-between gap-10 pb-24 sm:pb-28">
      <div class="hero-reveal flex text-sand-50 [text-shadow:0_1px_12px_rgba(28,26,23,0.45)]" style="--d:.5s">
        {[[`${formatNumber(totals.listings)}+`, 'Verified', 'Residences'], [`${totals.projects}+`, 'Premier', 'Developments'], ['0%', 'Direct', 'Brokerage Fee']].map(([v, l1, l2], i) => (
          <div class:list={['pr-5 sm:pr-8', i > 0 && 'border-l-[0.5px] border-sand-50/30 pl-5 sm:pl-8']}>
            <p class="font-display text-lg font-bold tracking-tight sm:text-xl">{v}</p>
            <p class="mt-1 font-mono text-[9px] uppercase leading-tight tracking-[0.2em] text-sand-50/85 sm:text-[10px]">{l1}<br />{l2}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div class="hero-reveal" style="--d:.7s">
          <h1 class="font-display text-[clamp(2rem,min(5.4vw,9svh),4.1rem)] font-extrabold uppercase leading-[0.9] tracking-[-0.02em] !text-sand-50">
            Search,<br />Compare &amp;<br />Own Your<br />Next Home
          </h1>
          <div class="mt-6 grid grid-cols-2 gap-2 sm:mt-7 sm:flex sm:flex-wrap sm:items-center sm:gap-4">
            <a href="#home-search" class="group inline-flex items-stretch justify-center border-[0.5px] border-sand-50/60 bg-sand-50 text-[#1C1A17] transition hover:bg-white">
              <span class="px-2 py-3 font-mono text-[10px] uppercase tracking-[0.12em] sm:px-5 sm:text-[12px] sm:tracking-[0.2em]">Explore Homes</span>
              <span class="hidden w-11 place-items-center sm:grid border-l-[0.5px] border-[#1C1A17]/30 transition group-hover:translate-x-0.5">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 7 5 5-5 5M13 7l5 5-5 5" /></svg>
              </span>
            </a>
            <button type="button" onclick="window.openTourModal('/videos/luxury_tower.mp4', 'The Waterfront Tower · Worli, Mumbai', '₹14.50 Cr – ₹32.00 Cr · Arabian Sea Panorama')" class="inline-flex items-center justify-center gap-2 border-[0.5px] border-sand-50/30 bg-white/5 px-2 py-3 font-mono text-[10px] uppercase tracking-[0.12em] sm:gap-2.5 sm:px-4 sm:text-[12px] sm:tracking-[0.2em] text-sand-50 backdrop-blur-md transition hover:border-sand-50/70 hover:bg-white/10 cursor-pointer">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              Watch 4K Tour
            </button>
          </div>
        </div>

        <p class="hero-reveal max-w-sm text-[12px] sm:text-[13px] font-medium uppercase leading-[1.45] tracking-[0.04em] text-sand-50/85 md:text-right" style="--d:.9s">
          Curated access to {formatNumber(totals.listings)}+ verified residences across {totals.cities} major metros and {totals.projects} premier developments with zero brokerage.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Cream editorial run: search dock → city marquee → about → collections ===== -->
  <div class="bg-sand-100 text-[#1C1A17]">
    <div class="container-x relative z-10 -mt-16 sm:-mt-20" id="home-search">
      <div class="mx-auto max-w-5xl bg-[#1C1A17] p-4 shadow-[0_30px_60px_-20px_rgba(28,26,23,0.5)] sm:p-6">
        <div class="mb-3 flex items-center justify-between gap-4">
          <p class="ed-label text-sand-50/70"><span class="bracket"></span>Find your home</p>
          <a href="#home-search" data-ask-plain class="font-mono text-[10px] uppercase tracking-[0.2em] text-sand-50/60 transition hover:text-sand-50">Ask in plain words →</a>
        </div>
        <SearchBox client:load {...sb} initialCity={currentCity(Astro.url, Astro.cookies, cities).slug} />
        <div class="mt-4 hidden space-y-1.5 border-t-[0.5px] border-sand-50/15 pt-3 text-xs text-sand-50/70 sm:block">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="w-28 font-mono text-[10px] uppercase tracking-[0.2em] text-sand-50/50">Trending</span>
            <a href="/buy/mumbai" class="transition hover:text-sand-50">Worli Waterfront Penthouses</a>
            <a href="/buy/mumbai" class="transition hover:text-sand-50">Alibaug Beach Villas</a>
            <a href="/buy/mumbai" class="transition hover:text-sand-50">Marine Drive Sky Suites</a>
            <a href="/buy/mumbai" class="transition hover:text-sand-50">BKC Grade-A Headquarters</a>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="w-28 font-mono text-[10px] uppercase tracking-[0.2em] text-sand-50/50">Prime markets</span>
            {[['Mumbai', 'mumbai'], ['Delhi NCR', 'delhi'], ['Bengaluru', 'bengaluru'], ['Pune', 'pune'], ['Hyderabad', 'hyderabad']].map(([n, s]) => <a href={`/buy/${s}`} class="transition hover:text-sand-50">{n}</a>)}
          </div>
        </div>
      </div>
    </div>

    <!-- City marquee -->
    <div class="ed-marquee mt-12 overflow-hidden border-y-[0.5px] border-[#1C1A17]/15 py-4 sm:mt-16" aria-label="Cities on InspiState">
      <div class="ed-marquee-track">
        {[0, 1].map((dup) => (
          <ul class="flex shrink-0 items-center" aria-hidden={dup === 1 ? 'true' : undefined}>
            {cities.map((city) => (
              <li class="flex items-center">
                <a href={`/city/${city.slug}`} tabindex={dup === 1 ? -1 : undefined} class="group flex items-baseline gap-2.5 px-6 sm:px-8">
                  <span class="font-display text-xl font-bold uppercase tracking-tight transition group-hover:text-accent-600 sm:text-2xl">{city.name}</span>
                  <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#1C1A17]/50">{formatNumber(statsFor(city.slug).total)} homes</span>
                </a>
                <span class="text-accent-500" aria-hidden="true">✦</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <!-- About -->
    <section class="container-x grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-24">
      <div class="relative pb-[14%] lg:col-span-5">
        <img src="/images/project-luxury-villa.jpg" alt="Contemporary villa with an infinity pool at dusk" loading="lazy" class="warm-tone aspect-[4/5] w-[80%] object-cover" />
        <img src="/images/interior-luxury-living.jpg" alt="Double-height living room" loading="lazy" class="warm-tone absolute bottom-0 right-0 aspect-square w-[50%] border-[6px] border-sand-100 object-cover sm:border-8" />
        <p class="absolute left-3 top-3 bg-sand-50/90 px-3 py-2 font-mono text-[10px] uppercase tracking-[0.2em] backdrop-blur-sm">100% RERA verified</p>
      </div>
      <div class="lg:col-span-7">
        <p class="ed-label text-[#1C1A17]/60"><span class="bracket"></span>About InspiState</p>
        <h2 class="mt-4 font-display text-[clamp(1.9rem,3.8vw,3.1rem)] font-bold leading-[1.02] tracking-[-0.02em] !text-[#1C1A17]">Verified homes,<br />honest data, zero&nbsp;brokerage.</h2>
        <p class="mt-6 max-w-xl text-[15px] leading-relaxed sm:text-base">
          InspiState helps you search verified homes for sale and rent, new launch projects and commercial spaces across India — with zero brokerage and a 100% RERA-certified portfolio.
        </p>
        <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-[#1C1A17]/60 sm:text-base">
          Property rates, price trends, valuation, home loans and free tools sit beside every listing, so each decision is informed by live market data rather than guesswork.
        </p>
        <div class="mt-9 grid grid-cols-2 border-y-[0.5px] border-[#1C1A17]/15 sm:grid-cols-4">
          {[[`${formatNumber(totals.listings)}+`, 'Verified residences'], [`${totals.cities}`, 'Major metros'], [`${totals.projects}`, 'Premier developments'], [`${totals.localities}`, 'Localities tracked']].map(([v, k], i) => (
            <div class:list={['py-5', i % 2 === 1 && 'border-l-[0.5px] border-[#1C1A17]/15 pl-5', i >= 2 && 'border-t-[0.5px] border-[#1C1A17]/15 sm:border-t-0', i === 2 && 'sm:border-l-[0.5px] sm:pl-5']}>
              <p class="font-display text-3xl font-bold tracking-tight">{v}</p>
              <p class="mt-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[#1C1A17]/60">{k}</p>
            </div>
          ))}
        </div>
        <div class="ed-pair mt-8">
          <a href="#home-search" class="ed-btn ed-btn-dark">Start your search <span aria-hidden="true">→</span></a>
          <a href="#expert" class="ed-btn ed-btn-ghost-dark">Talk to an expert</a>
        </div>
      </div>
    </section>

    <!-- Collections bento -->
    <section id="collections" class="container-x pb-16 sm:pb-20 lg:pb-24">
      <EdHead label="Curated collections" title="Spaces Worth<br />Coming Home To" sub="From sea-facing sky residences to waterfront villas and Grade-A offices — browse curated categories across India's prime markets." href="/buy/mumbai" linkLabel="View all properties" />
      <div class="grid grid-flow-dense auto-rows-[170px] grid-cols-2 gap-3 sm:auto-rows-[220px] sm:gap-4 lg:auto-rows-[230px] lg:grid-cols-4">
        {collections.map((m, i) => (
          <a href={m.href} class:list={['group relative block overflow-hidden bg-[#1C1A17]', m.span]}>
            <img src={m.img} alt={m.title} loading="lazy" class="warm-tone absolute inset-0 h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1C1A17]/85 via-[#1C1A17]/15 to-transparent"></div>
            <span class="absolute left-4 top-4 font-mono text-[10px] tracking-[0.2em] text-sand-50/80">0{i + 1}</span>
            <span class="absolute right-4 top-4 grid h-9 w-9 place-items-center border-[0.5px] border-sand-50/50 text-sand-50 opacity-0 transition duration-300 group-hover:opacity-100" aria-hidden="true">↗</span>
            <div class="absolute inset-x-4 bottom-4 text-sand-50">
              <p class:list={['font-display font-bold leading-tight tracking-tight', i === 0 ? 'text-xl sm:text-3xl' : 'text-[15px] sm:text-xl']}>{m.title}</p>
              <p class="mt-1.5 truncate font-mono text-[10px] uppercase tracking-[0.18em] text-sand-50/75">{m.sub}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="mr-2 font-mono text-[10px] uppercase tracking-[0.2em] text-[#1C1A17]/50">Also explore</span>
        {moreCollections.map((m) => (
          <a href={m.href} class="border-[0.5px] border-[#1C1A17]/25 px-3 py-1.5 text-xs transition hover:border-[#1C1A17] hover:bg-[#1C1A17] hover:text-sand-50">{m.title}</a>
        ))}
      </div>
    </section>
  </div>

  <!-- ===== Featured developments (espresso band) ===== -->
  <section class="bg-[#1C1A17] py-16 text-sand-50 sm:py-20 lg:py-24">
    <div class="container-x">
      <EdHead dark label="Hot deals" title="Hot Selling Projects<br />Across India" sub="The most sought-after residential launches right now — high demand, verified developers and transparent pricing." href="/new-projects/mumbai" linkLabel="View all projects" />
      <div class="ed-rail">
        {hotProjects.map((p) => (
          <article class="group relative">
            <a href={p.href} class="relative block aspect-[4/5] overflow-hidden bg-black">
              <img src={p.img} alt={`${p.name}, ${p.locality}`} loading="lazy" class="warm-tone absolute inset-0 h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1C1A17]/70 via-transparent to-[#1C1A17]/30"></div>
              <span class="absolute left-3 top-3 bg-sand-50 px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.18em] text-[#1C1A17]">{p.status}</span>
              <span class="absolute bottom-3 left-3 font-mono text-[10px] uppercase tracking-[0.18em] text-sand-50/85">RERA verified</span>
            </a>
            <div class="absolute right-3 top-3"><ShortlistButton client:visible kind="project" id={p.id} /></div>
            <div class="border-b-[0.5px] border-sand-50/15 pb-4 pt-4">
              <a href={p.href} class="block font-display text-lg font-bold leading-snug tracking-tight transition hover:text-accent-300">{p.name}</a>
              <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.18em] text-sand-50/55">{p.locality} · {p.city}</p>
              <p class="mt-3 text-[15px] font-semibold">{p.price}</p>
              <p class="mt-1 text-xs text-sand-50/60">{p.meta}</p>
