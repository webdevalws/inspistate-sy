  <script is:inline>
    // "Ask in plain words →": the search box below reads plain-language queries (Ask AI parser), so focus it with an
    // example. Without JS the link still jumps to #home-search.
    document.querySelector('[data-ask-plain]')?.addEventListener('click', function (e) {
      var input = document.querySelector('#home-search input[aria-label="Search by locality, project or builder"]');
      if (!input) return;
      e.preventDefault();
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      input.placeholder = 'Try: 2 BHK in Powai under 3 Cr, ready to move';
      input.focus({ preventScroll: true });
    });

    // Global functions for opening and switching modal video tours
    window.openTourModal = function(videoSrc, title, subtitle) {
      const modal = document.getElementById('video-modal');
      const modalVideo = document.getElementById('modal-tour-video');
      const titleEl = document.getElementById('modal-video-title');
      const subEl = document.getElementById('modal-video-sub');
      if (titleEl && title) titleEl.textContent = title;
      if (subEl && subtitle) subEl.textContent = subtitle;
      if (modalVideo && videoSrc) {
        if (!modalVideo.src.endsWith(videoSrc)) {
          modalVideo.src = videoSrc;
        }
        modalVideo.currentTime = 0;
        modalVideo.play().catch(function() {});
      }
      if (modal && typeof modal.showModal === 'function') {
        modal.showModal();
      }
    };

    window.switchTourVideo = function(src, title, subtitle) {
      const modalVideo = document.getElementById('modal-tour-video');
      const titleEl = document.getElementById('modal-video-title');
      const subEl = document.getElementById('modal-video-sub');
      if (titleEl && title) titleEl.textContent = title;
      if (subEl && subtitle) subEl.textContent = subtitle;
      if (modalVideo && src) {
        modalVideo.src = src;
        modalVideo.currentTime = 0;
        modalVideo.play().catch(function() {});
      }
    };

    // Modal lifecycle: Pause modal video when dialog closes
    const tourModal = document.getElementById('video-modal');
    if (tourModal) {
      tourModal.addEventListener('close', function() {
        const modalVideo = document.getElementById('modal-tour-video');
        if (modalVideo) modalVideo.pause();
      });
    }

    // Hero depth: the wordmark drifts slower than the photo layers on scroll and pointer move.
    (function initHeroDepth() {
      const hero = document.getElementById('hero');
      if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const layers = hero.querySelectorAll('.hero-layer');
      let px = 0, py = 0, raf = 0;
      function render() {
        raf = 0;
        const y = Math.min(window.scrollY, hero.offsetHeight);
        layers.forEach(function(el) {
          const d = parseFloat(el.getAttribute('data-depth') || '0');
          el.style.transform = 'translate3d(' + (px * d * 40) + 'px,' + (y * d + py * d * 24) + 'px,0)';
        });
      }
      const queue = function() { if (!raf) raf = requestAnimationFrame(render); };
      window.addEventListener('scroll', queue, { passive: true });
      hero.addEventListener('pointermove', function(e) {
        const r = hero.getBoundingClientRect();
        px = (e.clientX - r.left) / r.width - 0.5;
        py = (e.clientY - r.top) / r.height - 0.5;
        queue();
      });
    })();

  </script>

