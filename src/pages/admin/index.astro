---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminCounts } from '../../lib/repo';
import { userCounts } from '../../lib/admin-users';

// Dashboard: the headline numbers, and what is waiting in each section (each card links there).
const [counts, users, waiting] = await Promise.all([
  adminCounts(),
  userCounts(),
  env.DB.prepare(`SELECT
      (SELECT count(*) FROM reviews WHERE status = 'pending') + (SELECT count(*) FROM platform_reviews WHERE status = 'pending') AS reviews,
      (SELECT count(*) FROM subscriptions WHERE status = 'requested') AS plans,
      (SELECT count(*) FROM service_orders WHERE status NOT IN ('completed', 'cancelled')) AS orders`)
    .first<{ reviews: number; plans: number; orders: number }>(),
]);
const stats: [string, number][] = [['Leads (total)', counts.leads], ['Leads (24 h)', counts.leads24], ['Pending listings', counts.pending], ['Live listings', counts.active]];
const sections: [string, number, string, string][] = [
  ['Listings waiting for review', counts.pending, '/admin/listings', 'Review listings'],
  ['Reviews waiting', waiting?.reviews ?? 0, '/admin/reviews', 'Moderate reviews'],
  ['Agent plan requests', waiting?.plans ?? 0, '/admin/plans', 'See requests'],
  ['Open service orders', waiting?.orders ?? 0, '/admin/orders', 'See orders'],
  ['Users', users.all, '/admin/users', 'Manage users'],
  ['Blocked users', users.blocked, '/admin/users?state=blocked', 'See blocked'],
];
---
<AdminLayout title="Dashboard" active="dashboard" crumbs={[['Dashboard']]}>
  <dl class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {stats.map(([k, v]) => (
      <div class="rounded-2xl bg-white p-5 shadow-sm"><dt class="text-sm text-slate-500">{k}</dt><dd class="text-3xl font-extrabold text-slate-800">{v}</dd></div>
    ))}
  </dl>

  <h2 class="mt-10 text-xl font-bold text-slate-800">Waiting for you</h2>
  <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {sections.map(([label, n, href, cta]) => (
      <li class="flex items-center justify-between gap-4 rounded-2xl bg-white p-5 shadow-sm">
        <div><p class="text-sm text-slate-500">{label}</p><p class="text-2xl font-extrabold text-slate-800">{n}</p></div>
        <a href={href} class="btn-ghost py-2">{cta} →</a>
      </li>
    ))}
  </ul>

  <div class="mt-6 flex flex-wrap gap-2" aria-label="Users by role">
    {([['user', 'Buyers'], ['seller', 'Sellers'], ['agent', 'Agents'], ['none', 'Not registered']] as const).map(([k, l]) => (
      <a href={`/admin/users?role=${k}`} class="pill border border-slate-200 bg-white">{l} · {users[k]}</a>
    ))}
  </div>
</AdminLayout>
