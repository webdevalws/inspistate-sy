---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminCard from '../../components/admin/AdminCard.astro';
import Th from '../../components/admin/Th.astro';
import Pagination from '../../components/Pagination.astro';
import { LEAD_KINDS, type LeadKind } from '../../lib/repo';
import { paged } from '../../lib/admin-tables';
import { safeNext } from '../../lib/redirect';
import { EMPTY, TABLE, TABLE_WRAP, TBODY, TD, THEAD, fmtTime } from '../../components/admin/ui';

// Enquiries (leads), newest first: ?leads=<kind> filter, search, sort, 25 per page. Read-only.
const sp = Astro.url.searchParams;
const leadKind = LEAD_KINDS.find((k) => k === sp.get('leads')) as LeadKind | undefined;
type Lead = { id: number; name: string; phone: string; email: string | null; subject: string; page: string | null; kind: string; created_at: string };
const res = await paged<Lead>({
  from: 'leads ld', select: 'ld.id, ld.name, ld.phone, ld.email, ld.subject, ld.page, ld.kind, ld.created_at',
  where: leadKind ? ['ld.kind = ?'] : [], binds: leadKind ? [leadKind] : [],
  search: { columns: ['ld.name', 'ld.phone', 'ld.email', 'ld.subject'], idColumn: 'ld.id' },
  sorts: { date: 'ld.id', name: 'ld.name', type: 'ld.kind' },
  defaultSort: 'date', url: Astro.url,
});
const kindHref = (k: string) => { const u = new URLSearchParams([...sp].filter(([key]) => key !== 'leads' && key !== 'page')); if (k) u.set('leads', k); const s = u.toString(); return `/admin/enquiries${s ? `?${s}` : ''}`; };
---
<AdminLayout title="Enquiries" active="enquiries" crumbs={[['Enquiries']]}>
  <AdminCard title={`Enquiries (${res.total})`} id="leads" search={{ value: res.q, placeholder: 'Name, phone, email, subject', keep: { leads: leadKind, sort: sp.get('sort') ?? undefined, dir: sp.get('dir') ?? undefined } }}>
    <div class="mb-4 flex flex-wrap gap-2" aria-label="Filter by type">
      {[['', 'All'], ...LEAD_KINDS.map((k) => [k, k.replace('-', ' ')])].map(([k, l]) => (
        <a href={kindHref(k)} class:list={['pill border border-slate-200 bg-white capitalize', (leadKind ?? '') === k && 'pill-active']} aria-current={(leadKind ?? '') === k ? 'true' : undefined}>{l}</a>
      ))}
    </div>
    <div class={TABLE_WRAP}>
      <table class:list={[TABLE, 'min-w-[820px]']}>
        <thead class={THEAD}><tr><Th label="S.No." /><Th label="Name" sortKey="name" url={Astro.url} /><Th label="Type" sortKey="type" url={Astro.url} /><Th label="Phone" /><Th label="Email" /><Th label="About" /><Th label="Date" sortKey="date" url={Astro.url} /></tr></thead>
        <tbody class={TBODY}>
          {res.rows.map((ld, i) => (
            <tr>
              <td class={TD}>{res.offset + i + 1}</td>
              <td class:list={[TD, 'font-semibold text-slate-800']}>{ld.name}</td>
              <td class={TD}><span class="chip">{ld.kind}</span></td>
              <td class:list={[TD, 'whitespace-nowrap']}><a href={`tel:+91${ld.phone}`} class="text-brand-700 hover:underline">+91 {ld.phone}</a></td>
              <td class={TD}>{ld.email ?? '—'}</td>
              <td class={TD}>{safeNext(ld.page) ? <a href={safeNext(ld.page)!} class="text-brand-700 hover:underline">{ld.subject}</a> : ld.subject}</td>
              <td class:list={[TD, 'whitespace-nowrap text-slate-600']}>{fmtTime(ld.created_at)}</td>
            </tr>
          ))}
          {res.rows.length === 0 && <tr><td colspan="7" class={EMPTY}>{res.q ? 'No enquiries match.' : 'No enquiries yet.'}</td></tr>}
        </tbody>
      </table>
    </div>
    <Pagination page={res.page} pages={res.pages} url={Astro.url} />
  </AdminCard>
</AdminLayout>
