---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { buildReports } from '../../lib/research';

// Research report detail with bar charts and tables; printable as PDF.
const reports = await buildReports();
const r = reports.find((x) => x.slug === Astro.params.slug);
if (!r) return new Response(null, { status: 404 });
const related = reports.filter((x) => x.slug !== r.slug && x.category === r.category).slice(0, 3);
const date = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const jsonLd = { '@context': 'https://schema.org', '@type': 'Report', name: r.title, description: r.summary, datePublished: new Date().toISOString().slice(0, 10), author: { '@type': 'Organization', name: 'InspiState Research' } };
---
<Base title={`${r.title} | InspiState Research`} description={r.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="container-x max-w-4xl py-6">
    <Breadcrumbs items={[{ label: 'Research reports', href: '/research' }, { label: r.title }]} />
    <p class="eyebrow mt-4">{r.category} report · {date} · InspiState Research</p>
    <h1 class="mt-1 text-3xl font-extrabold">{r.title}</h1>
    <p class="mt-3 text-lg text-neutral-700">{r.summary}</p>
    <div class="mt-4 flex gap-2 print:hidden"><button onclick="window.print()" class="btn-primary">⤓ Download PDF</button>{r.citySlug && <a href={`/city/${r.citySlug}`} class="btn-ghost">Explore the city</a>}</div>
    {r.sections.map((s) => {
      const max = Math.max(...(s.bars ?? []).map((b) => b.value), 1);
      return (
        <section class="mt-10">
          <h2 class="text-xl font-bold">{s.heading}</h2>
          <p class="mt-1 text-sm text-neutral-600">{s.text}</p>
          {s.bars && (
            <div class="mt-4 space-y-2">
              {s.bars.map((b) => (
                <div class="grid grid-cols-[minmax(0,10rem)_1fr_auto] items-center gap-3 text-sm">
                  {b.href ? <a href={b.href} class="truncate font-medium text-brand-700 hover:underline">{b.label}</a> : <span class="truncate font-medium">{b.label}</span>}
                  <span class="h-3 rounded-full bg-neutral-100"><span class="block h-full rounded-full bg-brand-700" style={`width:${Math.max(2, (b.value / max) * 100)}%`} /></span>
                  <span class="w-24 text-right font-semibold">{b.display}</span>
                </div>
              ))}
            </div>
          )}
          {s.table && (
            <div class="mt-4 overflow-x-auto rounded-xl border border-neutral-200">
              <table class="w-full min-w-[560px] text-sm"><thead class="bg-neutral-50 text-left text-xs uppercase text-neutral-500"><tr>{s.table.head.map((h) => <th class="px-3 py-2">{h}</th>)}</tr></thead>
                <tbody class="divide-y divide-neutral-100">{s.table.rows.map((row) => <tr>{row.map((c, i) => <td class:list={['px-3 py-2', i === 0 && 'font-medium']}>{c}</td>)}</tr>)}</tbody></table>
            </div>
          )}
        </section>
      );
    })}
    <p class="mt-10 text-xs text-neutral-500">Source: InspiState listings data. Asking prices; registered transaction values may differ. Cite as “InspiState Research, {date}”.</p>
    {related.length > 0 && <section class="mt-10 print:hidden"><h2 class="mb-3 text-lg font-bold">More reports</h2><div class="grid gap-3 sm:grid-cols-3">{related.map((x) => <a href={`/research/${x.slug}`} class="card p-4 hover:border-brand-300"><p class="font-semibold">{x.title}</p><p class="mt-1 text-xs text-accent-700">{x.keyStat}</p></a>)}</div></section>}
  </article>
</Base>
