---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import Faq from '../../../components/Faq.astro';
import { getProjects, getRefs } from '../../../lib/repo';
import { localityMarket } from '../../../lib/community';
import { formatPrice, formatRate } from '../../../lib/format';
import { searchUrl } from '../../../lib/urls';

const refs = await getRefs();
const city = refs.city(Astro.params.city!);
const loc = city && refs.locality(city.slug, Astro.params.slug!);
if (!city || !loc) return new Response(null, { status: 404 });
const [market, projects] = await Promise.all([localityMarket(city.slug), getProjects({ citySlug: city.slug, localitySlug: loc.slug })]);
const m = market.get(loc.slug);
const peers = refs.localitiesOf(city.slug);
const cityAvg = peers.reduce((t, l) => t + l.ratePerSqft, 0) / peers.length;
const rank = [...peers].sort((a, b) => b.ratePerSqft - a.ratePerSqft).findIndex((l) => l.slug === loc.slug) + 1;
const yieldPct = ((loc.rentPerSqft * 12) / loc.ratePerSqft) * 100;
const nearby = peers.filter((l) => l.slug !== loc.slug).sort((a, b) => Math.hypot(a.lat - loc.lat, a.lng - loc.lng) - Math.hypot(b.lat - loc.lat, b.lng - loc.lng)).slice(0, 4);
const bbox = `${loc.lng - 0.03},${loc.lat - 0.02},${loc.lng + 0.03},${loc.lat + 0.02}`;
const vsCity = ((loc.ratePerSqft - cityAvg) / cityAvg) * 100;
const max = Math.max(...peers.map((l) => l.ratePerSqft));
const faq = [
  { q: `What is the property rate in ${loc.name}?`, a: `The average sale rate in ${loc.name} is ${formatRate(m?.sale_rate ?? loc.ratePerSqft)}, ${Math.abs(vsCity).toFixed(0)}% ${vsCity >= 0 ? 'above' : 'below'} the ${city.name} average.` },
  { q: `Is ${loc.name} a good place to invest?`, a: `${loc.name} prices grew ${loc.yoyGrowthPct}% in the last year and rental yield is about ${yieldPct.toFixed(1)}%. It ranks #${rank} of ${peers.length} ${city.name} localities by price.` },
  { q: `What is the average rent in ${loc.name}?`, a: `About ₹${loc.rentPerSqft}/sq.ft per month — roughly ₹${Math.round(loc.rentPerSqft * 1000).toLocaleString('en-IN')} for a 1,000 sq.ft home.` },
];
---
<Base title={`${loc.name}, ${city.name} — Property Rates, Projects & Locality Guide`} description={`${loc.name} locality guide: ${formatRate(loc.ratePerSqft)} average, ${loc.yoyGrowthPct}% yearly growth, rents, projects and listings for sale and rent.`}>
  <div class="container-x py-6">
    <Breadcrumbs items={[{ label: city.name, href: `/city/${city.slug}` }, { label: 'Property rates', href: `/property-rates/${city.slug}` }, { label: loc.name }]} />
    <h1 class="mt-3 text-2xl font-extrabold sm:text-3xl">{loc.name}, {city.name} — locality overview</h1>
    {loc.description && <p class="mt-3 max-w-3xl whitespace-pre-line leading-relaxed text-slate-700">{loc.description}</p>}

    <div class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-5">
      {[['Avg. sale rate', formatRate(m?.sale_rate ?? loc.ratePerSqft)], ['Yearly growth', `▲ ${loc.yoyGrowthPct}%`], ['Avg. rent', `₹${loc.rentPerSqft}/sq.ft`], ['Rental yield', `${yieldPct.toFixed(1)}%`], ['Price rank in city', `#${rank} of ${peers.length}`]].map(([k, v]) => <div class="card p-4"><p class="text-xs uppercase tracking-wide text-slate-500">{k}</p><p class="mt-1 text-xl font-extrabold">{v}</p></div>)}
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <a href={searchUrl('buy', city.slug, loc.slug)} class="btn-primary">Buy in {loc.name} ({m?.sale ?? 0})</a>
      <a href={searchUrl('rent', city.slug, loc.slug)} class="btn-ghost">Rent in {loc.name} ({m?.rent ?? 0})</a>
      <a href={`/new-projects/${city.slug}?locality=${loc.slug}`} class="btn-ghost">New projects ({projects.length})</a>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="card p-5">
        <h2 class="font-bold">Price vs other {city.name} localities</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {[...peers].sort((a, b) => b.ratePerSqft - a.ratePerSqft).map((l) => (
            <li class="grid grid-cols-[120px_1fr_90px] items-center gap-2">
              <a href={`/locality/${city.slug}/${l.slug}`} class:list={['truncate hover:underline', l.slug === loc.slug ? 'font-bold text-brand-700' : 'text-slate-600']}>{l.name}</a>
              <span class="h-2.5 rounded-full bg-slate-100"><span class:list={['block h-2.5 rounded-full', l.slug === loc.slug ? 'bg-brand-600' : 'bg-slate-300']} style={`width:${(l.ratePerSqft / max) * 100}%`}></span></span>
              <span class="text-right">{formatRate(l.ratePerSqft)}</span>
            </li>
          ))}
        </ul>
      </div>
      <iframe title={`Map of ${loc.name}`} class="h-80 w-full rounded-2xl border border-slate-200 lg:h-full" loading="lazy" src={`https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${loc.lat},${loc.lng}`}></iframe>
    </div>

    {projects.length > 0 && (
      <section class="mt-10">
        <h2 class="section-title mb-4">Projects in {loc.name}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{projects.map((p) => <ProjectCard project={p} />)}</div>
      </section>
    )}

    <section class="mt-10">
      <h2 class="section-title mb-4">Nearby localities</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {nearby.map((l) => <a href={`/locality/${city.slug}/${l.slug}`} class="card p-4 hover:border-brand-300"><p class="font-semibold">{l.name}</p><p class="text-sm text-slate-500">{formatRate(l.ratePerSqft)} · ▲{l.yoyGrowthPct}%</p></a>)}
      </div>
    </section>

    {m?.min_price && <p class="mt-6 text-sm text-slate-500">Homes for sale in {loc.name} start from {formatPrice(m.min_price)}.</p>}
    <div class="mt-10"><Faq items={faq} /></div>
  </div>
</Base>
