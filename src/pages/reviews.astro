---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Pagination from '../components/Pagination.astro';
import PlatformReviewForm from '../components/islands/PlatformReviewForm';
import { getRefs } from '../lib/repo';
import { listReviews, reviewSourceCounts, REVIEW_SERVICES } from '../lib/platform-reviews';

// Customer reviews of InspiState (by service) plus project reviews. See docs/functions/reviews/desc.md.
const refs = await getRefs();
const q = Astro.url.searchParams;
const source = q.get('source') ?? '';
const city = refs.cities.some((c) => c.slug === q.get('city')) ? q.get('city')! : '';
const validSource = source === 'projects' || Object.hasOwn(REVIEW_SERVICES, source) ? source : '';
const res = await listReviews({ source: validSource || undefined, city: city || undefined, page: Number(q.get('page')) || 1 });
const counts = await reviewSourceCounts();
const allCount = Object.values(counts).reduce((s, n) => s + n, 0);
const tabs: [string, string, number][] = [['', 'All', allCount], ['projects', 'Project reviews', counts.projects ?? 0], ...Object.entries(REVIEW_SERVICES).map(([k, v]) => [k, v, counts[k] ?? 0] as [string, string, number])];
const link = (k: string, v: string) => { const u = new URLSearchParams(q); if (v) u.set(k, v); else u.delete(k); u.delete('page'); const s = u.toString(); return `/reviews${s ? `?${s}` : ''}`; };
const label = (s: string) => (s === 'projects' ? 'Project review' : REVIEW_SERVICES[s as keyof typeof REVIEW_SERVICES] ?? s);
const cityName = (s: string | null) => refs.cities.find((c) => c.slug === s)?.name ?? null;
const ago = (iso: string) => { const d = Math.floor((Date.now() - new Date(iso).getTime()) / 864e5); return d < 1 ? 'today' : d < 7 ? `${d} day${d > 1 ? 's' : ''} ago` : d < 60 ? `${Math.floor(d / 7)} weeks ago` : `${Math.floor(d / 30)} months ago`; };
const faq = [
  { q: 'Who can write a review?', a: 'Anyone who has used InspiState to buy, rent, sell, take a loan or book a service. You don’t need an account.' },
  { q: 'How long until my review appears?', a: 'Reviews are checked for spam and personal information, usually within 24–48 hours.' },
  { q: 'Why was my review not published?', a: 'Reviews with abusive language, phone numbers, promotions or content unrelated to your experience are not published.' },
  { q: 'Can InspiState edit or remove negative reviews?', a: 'No. We publish honest reviews, positive or negative, as long as they follow the guidelines above.' },
];
---
<Base page={res.page} title={`InspiState Reviews${res.total ? ` — ${res.avg.toFixed(1)}★ from ${res.total} reviews` : ''}`} description="Read what home buyers, tenants and owners say about InspiState — or share your own experience.">
  <div class="container-x py-6">
    <Breadcrumbs items={[{ label: 'Reviews' }]} />
    <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_360px]">
      <div>
        <h1 class="text-3xl font-extrabold">Customer reviews</h1>
        <div class="mt-4 flex flex-wrap items-center gap-6 rounded-2xl bg-brand-900 p-6 text-white">
          <div><p class="text-5xl font-extrabold text-accent-400">{res.total ? res.avg.toFixed(1) : '—'}</p><p class="text-accent-400">{'★'.repeat(Math.round(res.avg))}<span class="text-white/30">{'★'.repeat(5 - Math.round(res.avg))}</span></p><p class="text-sm text-white/70">{res.total} reviews</p></div>
          <div class="min-w-48 flex-1 space-y-1">{res.dist.map((d) => <div class="flex items-center gap-2 text-sm"><span class="w-8">{d.stars}★</span><span class="h-2 flex-1 overflow-hidden rounded-full bg-white/15"><span class="block h-full bg-accent-400" style={`width:${res.total ? (d.count / res.total) * 100 : 0}%`} /></span><span class="w-8 text-right text-white/70">{d.count}</span></div>)}</div>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">{tabs.map(([k, l, n]) => <a href={link('source', k)} class:list={['pill', validSource === k && 'bg-brand-900 text-white']}>{l} <span class="opacity-60">{n}</span></a>)}</div>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm"><span class="font-semibold text-neutral-500">City</span><a href={link('city', '')} class:list={['pill', !city && 'bg-brand-900 text-white']}>All</a>{refs.cities.map((c) => <a href={link('city', c.slug)} class:list={['pill', city === c.slug && 'bg-brand-900 text-white']}>{c.name}</a>)}</div>
        <div class="mt-6 space-y-3">
          {res.reviews.length === 0 && <p class="panel text-center text-neutral-600">No reviews here yet — be the first to share your experience.</p>}
          {res.reviews.map((r) => (
            <article class="panel">
              <div class="flex flex-wrap items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-100 font-bold text-brand-900" aria-hidden="true">{r.author.trim()[0]?.toUpperCase()}</span>
                <div class="flex-1"><p class="font-semibold">{r.author}</p><p class="text-xs text-neutral-500">{ago(r.createdAt)}{cityName(r.city) && ` · ${cityName(r.city)}`} · {label(r.source)}</p></div>
                <span class="text-accent-500" aria-label={`${r.rating} out of 5`}>{'★'.repeat(r.rating)}<span class="text-neutral-200">{'★'.repeat(5 - r.rating)}</span></span>
              </div>
              {r.title && <p class="mt-3 font-semibold">{r.title}</p>}
              <p class="mt-2 text-sm text-neutral-700">{r.body}</p>
              {r.project && <a href={r.project.url} class="mt-2 inline-block text-xs font-semibold text-brand-700 hover:underline">About {r.project.name} →</a>}
            </article>
          ))}
        </div>
        <div class="mt-6"><Pagination page={res.page} pages={res.pages} url={Astro.url} /></div>
      </div>
      <aside class="space-y-4 lg:sticky lg:top-4 lg:h-fit">
        <div class="panel"><h2 class="mb-3 text-lg font-bold">Write a review</h2><PlatformReviewForm client:visible services={Object.entries(REVIEW_SERVICES)} cities={refs.cities.map((c) => [c.slug, c.name])} /></div>
      </aside>
    </div>
    <div class="panel mt-10"><Faq items={faq} /></div>
  </div>
</Base>
