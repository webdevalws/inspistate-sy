---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RoomArt from '../../components/RoomArt.astro';
import LeadDialog from '../../components/islands/LeadDialog';
import { IDEA_CATEGORIES, ideasFor } from '../../data/interiors';

// Design ideas gallery index. See docs/functions/design-ideas/desc.md.
const cats = IDEA_CATEGORIES.map((c, i) => ({ ...c, count: ideasFor(c.slug).length, first: ideasFor(c.slug)[0], i }));
---
<Base title="Home Interior Design Ideas — Rooms, Kitchens, Wardrobes" description="Browse interior design ideas for every room: living rooms, modular kitchens, bedrooms, wardrobes, bathrooms, pooja units and more, with indicative costs.">
  <section class="bg-brand-900 text-white">
    <div class="container-x py-10">
      <Breadcrumbs items={[{ label: 'Interiors', href: '/services/home-interiors' }, { label: 'Design ideas' }]} />
      <h1 class="mt-4 font-serif text-4xl font-bold text-white">Interior design ideas for every room</h1>
      <p class="mt-2 max-w-2xl text-white/80">Filter by style, colour and room size. Every idea shows an indicative cost so you can plan your budget.</p>
      <form action="/design-ideas/search" class="mt-6 flex max-w-xl gap-2"><input name="q" class="input flex-1" placeholder="Search by theme, colour or feature, e.g. ‘white modern kitchen’" aria-label="Search design ideas" /><button class="btn-primary">Search</button></form>
    </div>
  </section>
  <div class="container-x py-10">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {cats.map((c) => (
        <a href={`/design-ideas/${c.slug}`} class="card group overflow-hidden hover:border-brand-300">
          <RoomArt category={c.slug} colour={c.first.colour} style={c.first.style} seed={c.first.id} class="aspect-[4/3] w-full transition group-hover:scale-[1.02]" />
          <div class="p-4"><p class="font-bold text-brand-900">{c.name}</p><p class="text-xs font-semibold text-accent-700">{c.count} designs</p><p class="mt-1 line-clamp-2 text-sm text-neutral-600">{c.blurb}</p></div>
        </a>
      ))}
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <a href="/tools/interior-cost" class="panel hover:border-brand-300"><p class="text-2xl">🛋</p><p class="mt-2 font-bold">Full home cost calculator</p><p class="text-sm text-neutral-600">Room-by-room estimate in three packages.</p></a>
      <a href="/tools/modular-kitchen" class="panel hover:border-brand-300"><p class="text-2xl">🍳</p><p class="mt-2 font-bold">Modular kitchen calculator</p><p class="text-sm text-neutral-600">Cost by shape, size and package.</p></a>
      <div class="panel"><p class="text-2xl">✏</p><p class="mt-2 font-bold">Meet a designer</p><p class="mb-3 text-sm text-neutral-600">Free consultation with a 3D design of your space.</p><LeadDialog client:visible kind="callback" label="Book free consultation" subject="Interiors: design consultation" className="btn-primary" /></div>
    </div>
  </div>
</Base>
