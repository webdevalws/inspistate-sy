---
// Sample valuation report showing the format customers receive (illustrative data).
import '../../../styles/global.css';
const rows = [['Property', '2 BHK apartment, 9th floor, 1,050 sq.ft built-up'], ['Locality', 'Baner, Pune'], ['Age', '6 years'], ['Purpose', 'Home loan'], ['Inspection', 'Desktop (documents + market data)']];
const comps = [['Tower A, same society', '1,020 sq.ft', '₹1.14 Cr', '₹11,176'], ['Nearby project, 2019', '1,100 sq.ft', '₹1.21 Cr', '₹11,000'], ['Resale, 300 m away', '980 sq.ft', '₹1.05 Cr', '₹10,714']];
---
<!doctype html>
<html lang="en-IN">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Sample Valuation Report | InspiState</title>
    <style>@media print { .no-print { display: none } body { background: white } }</style></head>
  <body class="bg-canvas py-8">
    <div class="no-print mx-auto mb-4 flex max-w-3xl justify-end px-4"><button onclick="window.print()" class="btn-primary">Print / Save as PDF</button></div>
    <article class="mx-auto max-w-3xl bg-white p-10 shadow">
      <header class="flex items-start justify-between border-b-4 border-accent-500 pb-4">
        <div><p class="text-xs font-bold uppercase tracking-widest text-accent-600">Sample report</p><h1 class="text-2xl font-bold">Property Valuation Report</h1><p class="text-sm text-neutral-500">Report no. IS-VAL-000123 · Illustrative data</p></div>
        <div class="text-right"><p class="text-xs text-neutral-500">Fair market value</p><p class="text-2xl font-bold text-brand-900">₹1.12 Cr</p><p class="text-xs text-neutral-500">Range ₹1.06 – 1.18 Cr</p></div>
      </header>
      <section class="mt-6"><h2 class="font-bold">1. Property details</h2><dl class="mt-2 grid grid-cols-2 gap-2 text-sm">{rows.map(([k, v]) => <><dt class="text-neutral-500">{k}</dt><dd>{v}</dd></>)}</dl></section>
      <section class="mt-6"><h2 class="font-bold">2. Method</h2><p class="mt-2 text-sm">Sales comparison method using registered transactions and verified listings within 1 km, adjusted for floor, age, size and amenities.</p></section>
      <section class="mt-6"><h2 class="font-bold">3. Comparable properties</h2>
        <table class="mt-2 w-full text-sm"><thead class="border-b text-left text-xs uppercase text-neutral-500"><tr><th class="py-1">Comparable</th><th>Area</th><th>Price</th><th>₹/sq.ft</th></tr></thead><tbody class="divide-y">{comps.map((r) => <tr>{r.map((c) => <td class="py-1.5">{c}</td>)}</tr>)}</tbody></table></section>
      <section class="mt-6"><h2 class="font-bold">4. Adjustments</h2><ul class="mt-2 list-disc pl-5 text-sm"><li>Floor premium (9th of 14): +2%</li><li>Age (6 years): −3%</li><li>Corner unit with two balconies: +1.5%</li></ul></section>
      <section class="mt-6"><h2 class="font-bold">5. Valuer's declaration</h2><p class="mt-2 text-sm">The valuation is based on information available on the report date and on the documents provided. It is valid for 90 days.</p></section>
      <footer class="mt-10 border-t pt-4 text-xs text-neutral-500">This is a sample showing the report format. Real reports are prepared by a certified valuer for the specific property.</footer>
    </article>
  </body>
</html>
