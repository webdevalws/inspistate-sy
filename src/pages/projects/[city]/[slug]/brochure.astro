---
// Printable project fact sheet ("brochure"), opened after a brochure lead.
import '../../../../styles/global.css';
import { getProject, getRefs } from '../../../../lib/repo';
import { formatNumber, formatPrice, formatRange, formatRate } from '../../../../lib/format';
import { canOpenBrochure } from '../../../../lib/brochure';
import { projectUrl } from '../../../../lib/urls';

const p = await getProject(Astro.params.city!, Astro.params.slug!);
if (!p) return new Response(null, { status: 404 });
// Lead-gated on the server: without a brochure enquiry for this project, go to the project page,
// where "Download Brochure" asks for the details and then opens this page.
if (!(await canOpenBrochure(Astro.cookies, Astro.locals.user, p.id))) return Astro.redirect(projectUrl(p), 302);
const refs = await getRefs();
const loc = refs.locality(p.citySlug, p.localitySlug)!;
const city = refs.city(p.citySlug)!;
const builder = refs.builder(p.builderSlug)!;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{p.name} — Brochure | InspiState</title>
    <style>@media print { .no-print { display: none } body { background: white } }</style>
  </head>
  <body class="bg-slate-100 py-8 print:py-0">
    <div class="no-print mx-auto mb-4 flex max-w-3xl justify-end gap-2 px-4">
      <button onclick="window.print()" class="btn-primary">Print / Save as PDF</button>
    </div>
    <article class="mx-auto max-w-3xl bg-white p-10 shadow print:shadow-none">
      <header class="flex items-start justify-between border-b-4 border-brand-600 pb-5">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">{builder.name}</p>
          <h1 class="mt-1 text-3xl font-extrabold">{p.name}</h1>
          <p class="text-slate-600">{loc.name}, {city.name}</p>
        </div>
        <div class="text-right">
          <p class="text-xl font-extrabold">{formatRange(p.priceMin, p.priceMax)}</p>
          <p class="text-sm text-slate-500">{formatRate(p.ratePerSqft)}</p>
        </div>
      </header>
      <section class="mt-6 grid grid-cols-3 gap-4 text-sm">
        {[['Status', p.status], ['Possession', p.possession], ['RERA', p.rera], ['Land', `${p.landAcres} acres`], ['Towers', `${p.towers} · G+${p.floors}`], ['Units', formatNumber(p.totalUnits)]].map(([k, v]) => <div><p class="text-xs text-slate-500">{k}</p><p class="font-semibold">{v}</p></div>)}
      </section>
      <section class="mt-8">
        <h2 class="text-lg font-bold">Price list</h2>
        <table class="mt-2 w-full text-sm">
          <thead class="border-b text-left text-xs uppercase text-slate-500"><tr><th class="py-2">Configuration</th><th>Carpet area</th><th class="text-right">Price*</th></tr></thead>
          <tbody class="divide-y">{p.units.map((u) => <tr><td class="py-2">{u.label}</td><td>{formatNumber(u.carpetSqft)} sq.ft</td><td class="text-right font-semibold">{formatPrice(u.price)}</td></tr>)}</tbody>
        </table>
        <p class="mt-1 text-xs text-slate-500">*Plus GST, stamp duty, registration and other applicable charges.</p>
      </section>
      <section class="mt-8 grid grid-cols-2 gap-8 text-sm">
        <div><h2 class="text-lg font-bold">Highlights</h2><ul class="mt-2 list-inside list-disc space-y-1">{p.highlights.map((h) => <li>{h}</li>)}</ul></div>
        <div><h2 class="text-lg font-bold">Nearby</h2><ul class="mt-2 space-y-1">{p.nearby.map((n) => <li class="flex justify-between"><span>{n.name}</span><span>{n.km} km</span></li>)}</ul></div>
      </section>
      <section class="mt-8 text-sm"><h2 class="text-lg font-bold">Amenities</h2><p class="mt-2">{p.amenities.join(' · ')}</p></section>
      <footer class="mt-10 border-t pt-4 text-xs text-slate-500">Prepared by InspiState on {new Date().toLocaleDateString('en-IN')}. Verify all details with the developer and the {city.state} RERA portal before booking.</footer>
    </article>
  </body>
</html>
