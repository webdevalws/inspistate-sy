{
  "name": "inspistate",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:seed:build": "node db/build-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply inspistate-db --local",
    "db:seed:local": "wrangler d1 execute inspistate-db --local --file db/seed.sql",
    "db:reset:local": "npm run db:seed:build && npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply inspistate-db --remote",
    "db:seed:remote": "wrangler d1 execute inspistate-db --remote --file db/seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
